APP_ENV=local
APP_NAME=Geem
APP_URL=http://api.geem.dm:8000
# Exact SPA origins. For local *.geem.dm tenant hosts, API also allows
# http(s)://{sub.}geem.dm[:port] when APP_ENV=local (see main.py).
# Do NOT put api.geem.dm:5174 here — that is not a frontend origin.
# https://app-uat.geem.ai is the Cloudflare Tunnel UAT SPA (see docs/development.md).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://app.geem.dm:5173,http://app.geem.dm:5174,http://geem.dm:5173,http://geem.dm:5174,http://web.geem.dm:5173,https://app-uat.geem.ai

# Phase 2C SaaS cutover — Document / Query / Jobs require authenticated Workspace.
# Public remain: /api/auth/login|register|refresh (+ cookie refresh), /api/health/*.
# Identity + Workspace APIs always enforce their own auth regardless of this flag.
AUTH_REQUIRED=true

# Legacy unauthenticated MVP document writes (workspace_id=NULL) are retired.
# Keep false in all environments after Phase 2C migration.
LEGACY_MVP_WRITES_ENABLED=false

# Workspace subdomain root (Phase 1+). Local DX may use X-Workspace-Slug header
# only when APP_ENV=local (never trusted in production).
APP_ROOT_DOMAIN=geem.dm
APP_ADMIN_HOST=admin.geem.dm

# Auth / sessions (change JWT_SECRET in every non-local environment)
JWT_SECRET=change-me-in-production-use-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_REUSE_GRACE_SECONDS=60
AUTH_RATE_LIMIT_PER_MINUTE=20
# Only enable behind a proxy that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Cloudflare Tunnel UAT (locally-managed). Credentials live in
# infra/cloudflared/credentials.json (gitignored). Ingress is
# infra/cloudflared/config.yml — app-uat.geem.ai / api-uat.geem.ai.
#   cd infra && docker compose -f docker-compose.yml -f docker-compose.tunnel.yml up -d

# Idempotent platform-admin bootstrap: python -m app.identity.bootstrap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DEFAULT_WORKSPACE_SLUG=default
DEFAULT_WORKSPACE_NAME=Default Workspace

# Phase 5A — bootstrap/dev plan (NOT Geem commercial pricing). Seeded for existing Workspaces.
# Local/dev also seeds a demo Starter/Pro/Business catalog + credit packs (app.billing.seed).
BOOTSTRAP_PLAN_CODE=bootstrap_dev
BOOTSTRAP_PLAN_NAME=Bootstrap (development)
BOOTSTRAP_AI_TOKENS_DAILY=1000000
BOOTSTRAP_AI_TOKENS_WEEKLY=5000000
BOOTSTRAP_AI_TOKENS_MONTHLY=20000000
BOOTSTRAP_EXPERTS_LIMIT=100
BOOTSTRAP_STORAGE_BYTES=10737418240

# Internal Platform Knowledge Workspace (Phase 3A). Owns Platform Expert Documents.
# Distinct from DEFAULT_WORKSPACE_SLUG. Never appears in tenant switcher /auth/me.
PLATFORM_KNOWLEDGE_WORKSPACE_SLUG=platform-knowledge
PLATFORM_KNOWLEDGE_WORKSPACE_NAME=Platform Knowledge

# Optional extra reserved slugs (comma-separated), merged with built-in list
RESERVED_WORKSPACE_SLUGS=
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag
REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=arabic_rag_chunks_v1

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OCR / PDF parse — billed at AI_TOKEN_MULTIPLIER_OCR (default 3x)
OPENROUTER_PDF_TRIGGER_MODEL=openai/gpt-5.6-luna
OPENROUTER_PDF_ENGINE=mistral-ocr

# Embeddings — billed at AI_TOKEN_MULTIPLIER_EMBED (default 1x)
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Rerank — billed at AI_TOKEN_MULTIPLIER_RERANK (default 1x)
OPENROUTER_RERANK_MODEL=cohere/rerank-v3.5

# Chat / RAG generation — billed at AI_TOKEN_MULTIPLIER_CHAT (default 1x)
OPENROUTER_CHAT_MODEL=qwen/qwen3.8-max
OPENROUTER_CHAT_FALLBACK_MODEL=openai/gpt-5.6-terra
# Optional dedicated model for titles + general fallback (empty = chat model)
OPENROUTER_GENERAL_MODEL=

OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_DATA_COLLECTION=deny

# Workspace AI token pool — one allowance (BOOTSTRAP_AI_TOKENS_*).
# Each OpenRouter family converts into that pool:
#   billed_tokens = round(provider_tokens * multiplier)
# Defaults: chat/embed/rerank/title = 1x, OCR = 3x.
AI_TOKEN_MULTIPLIER_CHAT=1
AI_TOKEN_MULTIPLIER_EMBED=1
AI_TOKEN_MULTIPLIER_RERANK=1
AI_TOKEN_MULTIPLIER_OCR=3
AI_TOKEN_MULTIPLIER_TITLE=1
# Per-model overrides (wins over family). Keep in sync with OPENROUTER_*_MODEL.
AI_TOKEN_MODEL_MULTIPLIERS='{"qwen/qwen3.8-max":1,"openai/gpt-5.6-terra":1,"qwen/qwen3-embedding-8b":1,"cohere/rerank-v3.5":1,"openai/gpt-5.6-luna":3}'
# Used only when OpenRouter omits a usage payload.
AI_TOKEN_FALLBACK_EMBED=100
AI_TOKEN_FALLBACK_RERANK=50
AI_TOKEN_FALLBACK_OCR_PER_PAGE=500
AI_TOKEN_FALLBACK_TITLE=64

# When RAG has insufficient document context, also answer from general knowledge
GENERAL_FALLBACK_ENABLED=true

MAX_UPLOAD_MB=100
MAX_PDF_PAGES=1000

OCR_PAGE_CONCURRENCY=4
EMBEDDING_BATCH_SIZE=32

RETRIEVAL_TOP_K=20
RERANK_TOP_N=6
MAX_CONTEXT_TOKENS=12000

CHUNK_TARGET_MIN_TOKENS=350
CHUNK_TARGET_MAX_TOKENS=550
CHUNK_HARD_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=80

RAG_PIPELINE_VERSION=v1
LOG_LEVEL=INFO

# Phase 6A — billing secrets at rest (empty = derived from JWT_SECRET)
SECRETS_ENCRYPTION_KEY=

# Phase 6A — ClickPay hosted page (local fallback when DB credentials are empty)
CLICKPAY_PROFILE_ID=
CLICKPAY_SERVER_KEY=
CLICKPAY_TEST_MODE=true
CLICKPAY_BASE_URL=https://secure.clickpay.com.sa
BILLING_CURRENCY=SAR
# SPA origin for post-payment browser handoff. Empty: local uses
# http://app.{APP_ROOT_DOMAIN}:5174 when the root domain is not localhost,
# otherwise http://localhost:5174. Production must set this explicitly.
WORKSPACE_WEB_URL=http://app.geem.dm:5174
