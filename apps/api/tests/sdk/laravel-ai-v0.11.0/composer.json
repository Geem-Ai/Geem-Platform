{
  "name": "geem/laravel-ai-v0.11.0-contract",
  "description": "Exact current Laravel AI compatibility fixture for the Geem Client Agent API",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/ai": "0.11.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload-dev": {
    "psr-4": {
      "Geem\\AgentContract\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
