# Geem Workspace Web — local environment (geem.dm / dnsmasq)

# FastAPI base URL (browser-reachable)
VITE_API_URL=http://api.geem.dm:8000
# Tunnel overlay overrides this to https://api.geem.ai

# Root domain for workspace subdomain UX
# Local: acme.geem.dm · UAT tunnel / production: geem.ai
VITE_ROOT_DOMAIN=geem.dm

# local | production — controls whether X-Workspace-Slug is sent
# (backend only trusts that header when APP_ENV=local)
VITE_APP_ENV=local

# Optional UX guard for chat composer uploads (server CHAT_ATTACHMENT_MAX_MB is authoritative)
# VITE_CHAT_ATTACHMENT_MAX_MB=20

# Optional UX guards for Expert knowledge uploads (server MAX_UPLOAD_MB / MAX_PDF_PAGES are authoritative)
# VITE_MAX_UPLOAD_MB=100
# VITE_MAX_PDF_PAGES=1000

# Phase 9D — Google Picker (public values only; never put client secret here)
# VITE_GOOGLE_DRIVE_PICKER_API_KEY=
# VITE_GOOGLE_DRIVE_APP_ID=

# Phase 9D — Google Picker (optional; API may also echo these from server settings)
# VITE_GOOGLE_DRIVE_PICKER_API_KEY=
# VITE_GOOGLE_DRIVE_APP_ID=

# Cookie/CORS assumptions (Phase 1B/1C):
# - Browser uses credentials: include for auth cookie refresh
# - Refresh cookie is HttpOnly on API host (api.geem.dm or api.geem.ai), Path=/api/auth, SameSite=Lax
# - Local: Secure=false; Production: Secure=true
# - Open SPA as http://app.geem.dm:5174 or http://{slug}.geem.dm:5174 (not api.geem.dm:5174)
# - Tunnel: https://hub.geem.ai (Vite env overridden by docker-compose.tunnel.yml)
# - CORS_ORIGINS lists exact SPA origins; local also allows *.geem.dm via APP_ROOT_DOMAIN regex
