# Multi-stage production image: static dist served by nginx
ARG FRONTEND_NODE_BASE_IMAGE=node:22-alpine
ARG FRONTEND_NGINX_BASE_IMAGE=nginx:1.27-alpine

FROM ${FRONTEND_NODE_BASE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG PUBLIC_SITE_URL=https://geem.ai
ARG PUBLIC_WORKSPACE_URL=https://hub.geem.ai
ARG PUBLIC_SIGNUP_URL=
ARG PUBLIC_CONTACT_URL=
ARG PUBLIC_DOCS_URL=
ARG PUBLIC_API_BASE_URL=https://api.geem.ai
ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL \
    PUBLIC_WORKSPACE_URL=$PUBLIC_WORKSPACE_URL \
    PUBLIC_SIGNUP_URL=$PUBLIC_SIGNUP_URL \
    PUBLIC_CONTACT_URL=$PUBLIC_CONTACT_URL \
    PUBLIC_DOCS_URL=$PUBLIC_DOCS_URL \
    PUBLIC_API_BASE_URL=$PUBLIC_API_BASE_URL
RUN npm run build

FROM ${FRONTEND_NGINX_BASE_IMAGE}
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
