# Public marketing site (Astro inlines PUBLIC_* at build time)
# UAT Cloudflare Tunnel overlay overrides these to landpage-uat / app-uat / api-uat.

PUBLIC_SITE_URL=https://geem.ai

# Workspace SPA origin. Local DX: http://app.geem.dm:5174
# UAT tunnel overlay: https://app-uat.geem.ai
PUBLIC_WORKSPACE_URL=http://hub.geem.ai

# Defaults to {PUBLIC_WORKSPACE_URL}/register when unset
# PUBLIC_SIGNUP_URL=http://app.geem.dm:5174/register

# Optional. When unset, Contact CTA uses /[locale]/contact
# PUBLIC_CONTACT_URL=

# Optional. Footer Documentation link is omitted when unset
# PUBLIC_DOCS_URL=

# Placeholder host shown in the API curl sample (never a secret)
PUBLIC_API_BASE_URL=https://api.geem.ai
