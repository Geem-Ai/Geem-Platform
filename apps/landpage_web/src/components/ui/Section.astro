---
type Props = {
  id?: string;
  tone?: 'light' | 'dark';
  class?: string;
};

const { id, tone = 'light', class: className } = Astro.props;
---

<section
  id={id}
  class:list={['section-shell', tone === 'dark' ? 'section-dark' : 'section-light', className]}
>
  <div class="container-shell">
    <slot />
  </div>
</section>
