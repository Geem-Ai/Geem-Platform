---
import type { SiteCopy } from '../../content/site/types';

type Props = { copy: SiteCopy };
const { copy } = Astro.props;
const chat = copy.channels.nodes.find((n) => n.id === 'chat')?.label ?? 'Chat';
const systems = copy.channels.nodes.find((n) => n.id === 'api')?.label ?? 'Systems';
const whatsapp = copy.channels.nodes.find((n) => n.id === 'whatsapp')?.label ?? 'WhatsApp';
const website = copy.channels.nodes.find((n) => n.id === 'widget')?.label ?? 'Website';
const expertLabel = copy.brand.product;
---

<figure class="mt-10" data-reveal data-draw aria-label={copy.experts.diagramCaption}>
  <svg viewBox="0 0 640 220" class="hidden w-full md:block" role="img">
    <title>{copy.experts.diagramCaption}</title>
    <line class="diagram-line" x1="120" y1="110" x2="280" y2="110" stroke="#6ab6d8" stroke-width="2" fill="none" />
    <line class="diagram-line" x1="360" y1="110" x2="440" y2="40" stroke="#6ab6d8" stroke-width="2" fill="none" />
    <line class="diagram-line" x1="360" y1="110" x2="520" y2="110" stroke="#6ab6d8" stroke-width="2" fill="none" />
    <line class="diagram-line" x1="360" y1="110" x2="440" y2="180" stroke="#6ab6d8" stroke-width="2" fill="none" />

    <rect x="20" y="70" width="180" height="80" rx="18" fill="#0e2f44" />
    <text x="110" y="116" text-anchor="middle" fill="#f7f5f2" font-size="14" font-family="IBM Plex Sans Arabic, sans-serif">
      {copy.knowledge.eyebrow}
    </text>

    <rect class="expert-pulse" x="250" y="70" width="120" height="80" rx="18" fill="#214b68" stroke="#e4d2ae" stroke-width="1.5" />
    <text x="310" y="116" text-anchor="middle" fill="#e4d2ae" font-size="15" font-weight="600" font-family="IBM Plex Sans Arabic, sans-serif">
      {expertLabel}
    </text>

    <rect x="450" y="10" width="160" height="48" rx="14" fill="#ffffff" stroke="#d7e0e7" />
    <text x="530" y="40" text-anchor="middle" fill="#0e2f44" font-size="12" font-family="IBM Plex Sans Arabic, sans-serif">{chat}</text>
    <rect x="470" y="86" width="140" height="48" rx="14" fill="#ffffff" stroke="#d7e0e7" />
    <text x="540" y="116" text-anchor="middle" fill="#0e2f44" font-size="12" font-family="IBM Plex Sans Arabic, sans-serif">{systems}</text>
    <rect x="450" y="162" width="160" height="48" rx="14" fill="#ffffff" stroke="#d7e0e7" />
    <text x="530" y="192" text-anchor="middle" fill="#0e2f44" font-size="12" font-family="IBM Plex Sans Arabic, sans-serif">{whatsapp} / {website}</text>
  </svg>

  <ol class="grid gap-3 md:hidden">
    <li class="geem-card p-4 text-sm">{copy.knowledge.eyebrow}</li>
    <li class="geem-card p-4 text-sm font-semibold text-geem-navy-900">{expertLabel}</li>
    <li class="geem-card p-4 text-sm">{chat} / {systems} / {whatsapp} / {website}</li>
  </ol>
  <figcaption class="mt-4 text-sm text-geem-muted">{copy.experts.diagramCaption}</figcaption>
</figure>
