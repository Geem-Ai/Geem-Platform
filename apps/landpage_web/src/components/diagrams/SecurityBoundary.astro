---
import type { SecurityPageCopy } from '../../content/site/types';

type Props = {
  copy: SecurityPageCopy['boundary'];
};

const { copy } = Astro.props;
---

<figure
  class="security-boundary"
  aria-labelledby="security-boundary-title"
  aria-describedby="security-boundary-caption"
>
  <div class="security-boundary__stage">
    <svg class="security-boundary__links" viewBox="0 0 520 520" aria-hidden="true">
      <circle cx="260" cy="260" r="142"></circle>
      <circle cx="260" cy="260" r="188"></circle>
      <path d="M168 152 220 214M352 152l-52 62M168 368l52-62M352 368l-52-62"></path>
      <circle cx="168" cy="152" r="4"></circle>
      <circle cx="352" cy="152" r="4"></circle>
      <circle cx="168" cy="368" r="4"></circle>
      <circle cx="352" cy="368" r="4"></circle>
    </svg>

    <div class="security-boundary__core">
      <span class="security-boundary__shield" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <path d="M16 3.5 26 7v7.7c0 6.2-4.1 11.2-10 13.8-5.9-2.6-10-7.6-10-13.8V7l10-3.5Z"></path>
          <path d="m11.5 16 3 3 6.5-7"></path>
        </svg>
      </span>
      <span>{copy.label}</span>
      <strong id="security-boundary-title">{copy.title}</strong>
    </div>

    <ul class="security-boundary__nodes">
      {
        copy.items.map((item) => (
          <li class="security-boundary__node" data-node={item.id}>
            <span class="security-boundary__node-icon" aria-hidden="true">
              {item.id === 'knowledge' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M7 3.5h7l4 4V20.5H7z"></path>
                  <path d="M14 3.5v4h4M10 12h5M10 15.5h4"></path>
                </svg>
              )}
              {item.id === 'permissions' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="9" cy="8" r="3"></circle>
                  <path d="M3.5 18c.7-3.1 2.5-4.6 5.5-4.6 1.4 0 2.5.3 3.4 1M15 12.5l2 2 3.5-4"></path>
                </svg>
              )}
              {item.id === 'credentials' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="8.5" cy="12" r="4"></circle>
                  <path d="M12.5 12H21M17 12v3M20 12v2"></path>
                </svg>
              )}
              {item.id === 'residency' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 21s6-5.6 6-11a6 6 0 1 0-12 0c0 5.4 6 11 6 11Z"></path>
                  <circle cx="12" cy="10" r="2"></circle>
                </svg>
              )}
            </span>
            <span>{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <figcaption id="security-boundary-caption">{copy.caption}</figcaption>
</figure>

<style>
  .security-boundary {
    min-width: 0;
    margin: 0;
  }

  .security-boundary__stage {
    position: relative;
    min-block-size: 32rem;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, white 13%, transparent);
    border-radius: clamp(1.5rem, 4vw, 2.25rem);
    background:
      radial-gradient(circle at 50% 48%, color-mix(in oklab, var(--geem-sand) 16%, transparent), transparent 24%),
      radial-gradient(circle at 50% 50%, color-mix(in oklab, var(--geem-sky) 12%, transparent), transparent 60%),
      color-mix(in oklab, white 4%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 8%, transparent),
      0 32px 80px color-mix(in oklab, black 24%, transparent);
  }

  .security-boundary__stage::before {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in oklab, white 12%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
    content: '';
    mask-image: radial-gradient(circle, black 10%, transparent 72%);
    opacity: 0.65;
  }

  .security-boundary__links {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    stroke: color-mix(in oklab, var(--geem-sky) 55%, transparent);
    stroke-dasharray: 3 6;
    stroke-linecap: round;
    stroke-width: 1.25;
  }

  .security-boundary__links circle:nth-child(-n + 2) {
    fill: none;
    stroke: color-mix(in oklab, white 9%, transparent);
    stroke-dasharray: none;
  }

  .security-boundary__links circle:nth-child(n + 3) {
    fill: var(--geem-sand);
    stroke: color-mix(in oklab, var(--geem-sand) 35%, transparent);
    stroke-width: 6;
  }

  .security-boundary__core {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    z-index: 2;
    display: grid;
    inline-size: 12rem;
    block-size: 12rem;
    place-content: center;
    justify-items: center;
    border: 1px solid color-mix(in oklab, var(--geem-sand) 58%, transparent);
    border-radius: 50%;
    background: linear-gradient(145deg, var(--geem-navy-800), var(--geem-navy-950));
    box-shadow:
      0 0 0 1rem color-mix(in oklab, var(--geem-sky) 5%, transparent),
      0 22px 50px color-mix(in oklab, black 30%, transparent);
    text-align: center;
    transform: translate(50%, -50%);
  }

  :global(html[dir='ltr']) .security-boundary__core {
    transform: translate(-50%, -50%);
  }

  .security-boundary__shield {
    display: grid;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    place-items: center;
    margin-block-end: 0.65rem;
    border-radius: 1rem;
    background: var(--geem-sand);
    color: var(--geem-navy-950);
  }

  .security-boundary__shield svg {
    inline-size: 1.8rem;
    block-size: 1.8rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .security-boundary__core > span:last-of-type {
    color: color-mix(in oklab, white 58%, transparent);
    font-size: 0.72rem;
  }

  .security-boundary__core strong {
    max-inline-size: 9rem;
    margin-block-start: 0.2rem;
    color: white;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .security-boundary__nodes {
    position: absolute;
    inset: 0;
    z-index: 3;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .security-boundary__node {
    position: absolute;
    display: flex;
    max-inline-size: 12rem;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid color-mix(in oklab, white 13%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--geem-navy-950) 72%, transparent);
    color: color-mix(in oklab, white 86%, transparent);
    font-size: 0.78rem;
    line-height: 1.35;
    backdrop-filter: blur(12px);
  }

  .security-boundary__node[data-node='knowledge'] {
    inset-block-start: 2.25rem;
    inset-inline-start: 1.5rem;
  }

  .security-boundary__node[data-node='permissions'] {
    inset-block-start: 2.25rem;
    inset-inline-end: 1.5rem;
  }

  .security-boundary__node[data-node='credentials'] {
    inset-block-end: 2.25rem;
    inset-inline-start: 1.5rem;
  }

  .security-boundary__node[data-node='residency'] {
    inset-block-end: 2.25rem;
    inset-inline-end: 1.5rem;
  }

  .security-boundary__node-icon {
    display: grid;
    inline-size: 2rem;
    block-size: 2rem;
    flex: none;
    place-items: center;
    border-radius: 0.7rem;
    background: color-mix(in oklab, var(--geem-sky) 14%, transparent);
    color: var(--geem-sky);
  }

  .security-boundary__node-icon svg {
    inline-size: 1.15rem;
    block-size: 1.15rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .security-boundary figcaption {
    max-inline-size: 38rem;
    margin-block-start: 1rem;
    color: color-mix(in oklab, white 58%, transparent);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .security-boundary__stage {
      min-block-size: 0;
      padding: 1.25rem;
    }

    .security-boundary__links {
      display: none;
    }

    .security-boundary__core {
      position: relative;
      inset: auto;
      inline-size: 10.5rem;
      block-size: 10.5rem;
      margin-inline: auto;
      margin-block-end: 1.25rem;
      transform: none;
    }

    :global(html[dir='ltr']) .security-boundary__core {
      transform: none;
    }

    .security-boundary__nodes {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .security-boundary__node {
      position: relative;
      inset: auto !important;
      max-inline-size: none;
      min-block-size: 4rem;
      background: color-mix(in oklab, var(--geem-navy-950) 50%, transparent);
    }
  }

  @media (max-width: 430px) {
    .security-boundary__nodes {
      grid-template-columns: 1fr;
    }
  }
</style>
