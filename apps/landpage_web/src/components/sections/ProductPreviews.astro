---
import type { SiteCopy } from '../../content/site/types';
import Section from '../ui/Section.astro';
import { Image } from 'astro:assets';
import avatar from '../../assets/brand/geem-avatar.webp';

type Props = { copy: SiteCopy };
const { copy } = Astro.props;
---

<Section tone="light" class="!pt-0">
  <div class="max-w-3xl" data-reveal>
    <p class="eyebrow"><span class="section-number">{copy.previews.number}</span> {copy.previews.eyebrow}</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{copy.previews.title}</h2>
    <p class="mt-4 text-lg text-geem-muted">{copy.previews.description}</p>
  </div>

  <div class="mt-10 grid gap-5 lg:grid-cols-2" data-reveal-stagger>
    {
      copy.previews.items.map((item, index) => (
        <article class="preview-tilt geem-card overflow-hidden">
          <div class="flex items-center gap-2 border-b border-geem-border bg-geem-navy-900 px-4 py-2">
            <span class="size-2.5 rounded-full bg-red-400/80" aria-hidden="true" />
            <span class="size-2.5 rounded-full bg-amber-300/80" aria-hidden="true" />
            <span class="size-2.5 rounded-full bg-emerald-400/80" aria-hidden="true" />
            <span class="ms-2 text-xs text-white/70">{item.title}</span>
          </div>
          <div class="grid gap-3 bg-white p-5 sm:grid-cols-[1fr_1.2fr]">
            <div class="space-y-2 rounded-xl bg-geem-surface p-3">
              <div class="flex items-center gap-2">
                <Image src={avatar} alt="" width={28} height={28} class="size-7 rounded-full" loading="lazy" />
                <div class="h-2 w-20 rounded bg-geem-border" />
              </div>
              <div class="h-8 rounded-lg bg-white border border-geem-border" />
              <div class="h-8 rounded-lg bg-white border border-geem-border" />
              <div class="h-8 rounded-lg bg-geem-navy-900/10 border border-geem-border" />
            </div>
            <div class="space-y-3 rounded-xl border border-geem-border p-3">
              <div class="ms-auto max-w-[85%] rounded-2xl bg-geem-navy-900 px-3 py-2 text-xs text-white">
                {index % 2 === 0 ? '…' : '…'}
              </div>
              <div class="flex gap-2">
                <Image src={avatar} alt="" width={24} height={24} class="size-6 rounded-full" loading="lazy" />
                <div class="rounded-2xl bg-geem-surface px-3 py-2 text-xs text-geem-muted">
                  {item.caption}
                </div>
              </div>
              <div class="h-10 rounded-xl border border-dashed border-geem-border" />
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>
