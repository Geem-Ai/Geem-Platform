---
import type { SiteCopy } from '../../content/site/types';
import Section from '../ui/Section.astro';
import { getSiteConfig } from '../../lib/site';

type Props = { copy: SiteCopy };
const { copy } = Astro.props;
const { apiBaseUrl } = getSiteConfig();

const sample = `curl -X POST "${apiBaseUrl}/api/v1/chat/completions" \\
  -H "Authorization: Bearer YOUR_API_KEY" \\
  -H "X-Geem-Expert-Id: YOUR_EXPERT_ID" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "dalseen/geem-1.0",
    "messages": [
      {
        "role": "user",
        "content": "Summarize our leave policy"
      }
    ],
    "stream": false
  }'`;
---

<Section id="api" tone="dark">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
    <div data-reveal>
      <p class="eyebrow"><span class="section-number">{copy.api.number}</span> {copy.api.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{copy.api.title}</h2>
      <p class="mt-4 text-lg text-white/75">{copy.api.description}</p>
      <ul class="mt-6 space-y-3">
        {
          copy.api.points.map((point) => (
            <li class="flex gap-3 text-white/85">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-geem-sand" aria-hidden="true" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="code-panel p-4 md:p-5" data-reveal>
      <div class="mb-3 flex items-center justify-between gap-3">
        <span class="text-xs tracking-wide text-white/55">{copy.api.sampleLabel}</span>
        <button
          type="button"
          class="rounded-full border border-white/20 px-3 py-1 text-xs text-white/85 hover:bg-white/10"
          data-copy="api-sample"
          data-copied-label={copy.api.copiedLabel}
        >
          {copy.api.copyLabel}
        </button>
      </div>
      <pre
        id="api-sample"
        dir="ltr"
        class="overflow-x-auto whitespace-pre text-left text-sm leading-relaxed text-geem-sand/95"
      ><code>{sample}</code></pre>
    </div>
  </div>
</Section>
