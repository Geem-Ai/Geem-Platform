---
import type { SiteCopy } from '../../content/site/types';
import Section from '../ui/Section.astro';
import { getSiteConfig } from '../../lib/site';

type Props = { copy: SiteCopy };
const { copy } = Astro.props;
const { apiBaseUrl } = getSiteConfig();

const sample = `curl -X POST "${apiBaseUrl}/api/v1/chat/completions" \\
  -H "Authorization: Bearer YOUR_API_KEY" \\
  -H "X-Geem-Expert-Id: YOUR_EXPERT_ID" \\
  -H "Content-Type: application/json" \\
  -d '{"model":"dalseen/geem-1.0",
       "messages":[{"role":"user","content":"Summarize our leave policy"}],
       "stream":false}'`;
---

<Section id="api" tone="dark">
  <div class="grid min-w-0 gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-12">
    <div class="min-w-0" data-reveal>
      <p class="eyebrow"><span class="section-number">{copy.api.number}</span> {copy.api.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{copy.api.title}</h2>
      <p class="mt-4 text-lg text-white/75">{copy.api.description}</p>
      <ul class="mt-6 grid gap-x-5 gap-y-2 sm:grid-cols-2">
        {
          copy.api.points.map((point) => (
            <li class="flex min-w-0 items-start gap-2.5 text-sm text-white/80">
              <svg class="mt-1 size-4 shrink-0 text-geem-sand" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="m5 10 3 3 7-7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path>
              </svg>
              <span class="min-w-0">{point}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="code-panel min-w-0 max-w-full overflow-hidden p-4 md:p-5" data-reveal>
      <div class="mb-3 flex items-center justify-between gap-3">
        <span class="text-xs tracking-wide text-white/55">{copy.api.sampleLabel}</span>
        <button
          type="button"
          class="rounded-full border border-white/20 px-3 py-1 text-xs text-white/85 hover:bg-white/10"
          data-copy="api-sample"
          data-copied-label={copy.api.copiedLabel}
        >
          {copy.api.copyLabel}
        </button>
      </div>
      <pre
        id="api-sample"
        dir="ltr"
        class="max-w-full overflow-x-auto whitespace-pre text-left text-xs leading-relaxed text-geem-sand/95 sm:text-sm"
      ><code>{sample}</code></pre>
    </div>
  </div>
</Section>
