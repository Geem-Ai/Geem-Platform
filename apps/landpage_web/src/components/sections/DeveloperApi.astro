---
import type { SiteCopy } from '../../content/site/types';
import type { Locale } from '../../lib/i18n';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import { localizedPath } from '../../lib/site';

type Props = { locale: Locale; copy: SiteCopy };
const { locale, copy } = Astro.props;
---

<Section id="api" tone="dark">
  <div class="grid min-w-0 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-16">
    <div class="min-w-0" data-reveal>
      <p class="eyebrow"><span class="section-number">{copy.api.number}</span> {copy.api.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{copy.api.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-white/75">{copy.api.description}</p>
      <ul class="mt-6 grid gap-3">
        {copy.api.points.map((point) => (
          <li class="flex min-w-0 items-start gap-3 text-sm text-white/80">
            <svg class="mt-1 size-4 shrink-0 text-geem-sand" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="m5 10 3 3 7-7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path>
            </svg>
            <span>{point}</span>
          </li>
        ))}
      </ul>
      <div class="mt-8"><Button href={localizedPath(locale, 'agent-ai')} variant="secondary">{copy.api.docsLabel}</Button></div>
    </div>
    <div class="action-paths" data-reveal>
      {copy.api.paths.map((path, index) => (
        <article class="action-path">
          <div class="path-heading">
            <span class="path-symbol" aria-hidden="true">{index === 0 ? '{ }' : '↗'}</span>
            <h3 dir="auto">{path.title}</h3>
          </div>
          <p>{path.description}</p>
        </article>
      ))}
    </div>
  </div>
</Section>

<style>
  .action-paths { display: grid; gap: 1.15rem; min-width: 0; }
  .action-path { border: 1px solid #416272; border-radius: 1.25rem; padding: clamp(1.4rem, 3vw, 2rem); background: rgb(255 255 255 / .04); }
  .path-heading { display: flex; gap: 1rem; align-items: center; }
  .path-symbol { display: grid; place-items: center; flex: 0 0 auto; width: 3rem; height: 3rem; border-radius: .8rem; background: #1a525f; color: #a4efdf; font: 600 1.4rem/1 monospace; }
  .action-path:nth-child(2) .path-symbol { background: #413c62; color: #d1c5ff; }
  h3 { font-size: 1.35rem; font-weight: 600; }
  .action-path p { margin-block-start: 1.1rem; color: #c6d9e3; font-size: 1rem; line-height: 1.8; }
</style>
