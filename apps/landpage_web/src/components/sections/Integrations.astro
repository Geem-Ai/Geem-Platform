---
import type { SiteCopy } from '../../content/site/types';
import Section from '../ui/Section.astro';
import googleDrive from '../../assets/apps/google-drive.svg';
import oneDrive from '../../assets/apps/microsoft-onedrive.svg';
import whatsapp from '../../assets/apps/whatsapp.svg';
import chatWidget from '../../assets/apps/chat-widget.svg';

type Props = { copy: SiteCopy };
const { copy } = Astro.props;

const icons: Record<string, string> = {
  'google-drive': googleDrive.src,
  'microsoft-onedrive': oneDrive.src,
  whatsapp: whatsapp.src,
  'chat-widget': chatWidget.src,
};
---

<Section id="integrations" tone="light">
  <div class="integration-panel" data-reveal>
    <div class="max-w-xl">
      <p class="eyebrow"><span class="section-number">{copy.integrations.number}</span> {copy.integrations.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{copy.integrations.title}</h2>
      <p class="mt-4 text-lg text-geem-muted">{copy.integrations.description}</p>
    </div>

    <ul class="integration-list" data-reveal-stagger>
      {
        copy.integrations.items.map((item) => (
          <li class="integration-item">
            <span class="integration-icon">
              <img src={icons[item.id]} alt="" width="36" height="36" loading="lazy" />
            </span>
            <span class="min-w-0">
              <strong>{item.title}</strong>
              <small>{item.description}</small>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .integration-panel {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--geem-border);
    border-radius: clamp(1.5rem, 3vw, 2rem);
    background:
      radial-gradient(circle at 100% 0%, color-mix(in oklab, var(--geem-sky) 12%, transparent), transparent 42%),
      white;
    box-shadow: 0 20px 60px color-mix(in oklab, var(--geem-navy-950) 6%, transparent);
  }

  .integration-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .integration-item {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem;
    border: 1px solid color-mix(in oklab, var(--geem-navy-900) 9%, white);
    border-radius: 1rem;
    background: var(--geem-surface);
  }

  .integration-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border: 1px solid var(--geem-border);
    border-radius: 0.85rem;
    background: white;
  }

  .integration-icon img {
    inline-size: 2rem;
    block-size: 2rem;
    object-fit: contain;
  }

  .integration-item strong,
  .integration-item small {
    display: block;
  }

  .integration-item strong {
    color: var(--geem-navy-900);
    font-size: 0.9rem;
  }

  .integration-item small {
    margin-block-start: 0.12rem;
    color: var(--geem-muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  @media (min-width: 900px) {
    .integration-panel {
      grid-template-columns: minmax(0, 1fr) minmax(24rem, 0.9fr);
    }
  }

  @media (max-width: 520px) {
    .integration-list {
      grid-template-columns: 1fr;
    }
  }
</style>
