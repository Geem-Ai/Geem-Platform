---
import type { SiteCopy } from '../../content/site/types';
import { getProductEcosystemCopy } from '../../content/product-ecosystem';
import type { Locale } from '../../lib/i18n';
import Section from '../ui/Section.astro';
import googleDrive from '../../assets/apps/google-drive.svg';
import oneDrive from '../../assets/apps/microsoft-onedrive.svg';
import whatsapp from '../../assets/apps/whatsapp.svg';
import chatWidget from '../../assets/apps/chat-widget.svg';

type Props = { copy: SiteCopy; locale: Locale };
const { copy, locale } = Astro.props;
const ecosystem = getProductEcosystemCopy(locale);
const ecosystemTitleId = `product-ecosystem-title-${locale}`;

const icons: Record<string, string> = {
  'google-drive': googleDrive.src,
  'microsoft-onedrive': oneDrive.src,
  whatsapp: whatsapp.src,
  'chat-widget': chatWidget.src,
};
---

<Section id="integrations" tone="light">
  <div class="integration-panel" data-reveal>
    <div class="max-w-xl">
      <p class="eyebrow"><span class="section-number">{copy.integrations.number}</span> {copy.integrations.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{copy.integrations.title}</h2>
      <p class="mt-4 text-lg text-geem-muted">{copy.integrations.description}</p>
    </div>

    <ul class="integration-list" data-reveal-stagger>
      {
        copy.integrations.items.map((item) => (
          <li class="integration-item">
            <span class="integration-icon">
              <img src={icons[item.id]} alt="" width="36" height="36" loading="lazy" />
            </span>
            <span class="min-w-0">
              <strong>{item.title}</strong>
              <small>{item.description}</small>
            </span>
          </li>
        ))
      }
    </ul>

    <article class="system-callout">
      <span class="system-callout__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <rect x="3.5" y="4.5" width="7" height="7" rx="2"></rect>
          <rect x="21.5" y="4.5" width="7" height="7" rx="2"></rect>
          <rect x="12.5" y="20.5" width="7" height="7" rx="2"></rect>
          <circle cx="16" cy="14.5" r="3"></circle>
          <path d="m10.5 10.5 3.3 2.5M21.5 10.5 18.2 13M16 17.5v3"></path>
        </svg>
      </span>

      <div class="system-callout__copy">
        <p>{copy.integrations.systemCard.eyebrow}</p>
        <h3>{copy.integrations.systemCard.title}</h3>
        <p>{copy.integrations.systemCard.description}</p>
      </div>

      <ul class="system-callout__tags" aria-label={copy.integrations.systemCard.eyebrow}>
        {copy.integrations.systemCard.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </article>

    <article class="product-ecosystem" aria-labelledby={ecosystemTitleId}>
      <header class="product-ecosystem__heading">
        <div>
          <p class="product-ecosystem__status"><span aria-hidden="true"></span>{ecosystem.status}</p>
          <h3 id={ecosystemTitleId}>{ecosystem.title}</h3>
        </div>
        <p class="product-ecosystem__description">{ecosystem.description}</p>
      </header>

      <ul class="product-ecosystem__products" role="list">
        {ecosystem.products.map((product) => (
          <li class={`ecosystem-product ecosystem-product--${product.id}`}>
            <span class="ecosystem-product__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                {product.id === 'erp' && <>
                  <rect x="5" y="5" width="9" height="9" rx="2" />
                  <rect x="18" y="5" width="9" height="9" rx="2" />
                  <rect x="5" y="18" width="9" height="9" rx="2" />
                  <path d="M18 22.5h9M22.5 18v9" />
                </>}
                {product.id === 'platform' && <>
                  <rect x="4" y="5" width="24" height="22" rx="3" />
                  <path d="M4 12h24M12 12v15M8 8.5h.01M12 8.5h.01M17 17h6M17 22h4" />
                </>}
                {product.id === 'qaf-noon' && <>
                  <path d="M16 7c-4-2.5-8-2.5-12-1v21c4-1.5 8-1.5 12 1 4-2.5 8-2.5 12-1V6c-4-1.5-8-1.5-12 1ZM16 7v21M8 12h4M8 17h4M20 12h4M20 17h4" />
                </>}
              </svg>
            </span>
            <div class="ecosystem-product__copy">
              <h4><bdi dir="ltr" lang="en">{product.name}</bdi></h4>
              <p>{product.description}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="product-ecosystem__value">
        <span class="product-ecosystem__value-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M19 8a7 7 0 0 0-12-2L4 9m0-5v5h5M5 16a7 7 0 0 0 12 2l3-3m0 5v-5h-5" /></svg>
        </span>
        <p><strong>{ecosystem.valueTitle}</strong><span>{ecosystem.value}</span></p>
      </div>
    </article>
  </div>
</Section>

<style>
  .integration-panel {
    display: grid;
    column-gap: clamp(2rem, 5vw, 4rem);
    row-gap: clamp(1.5rem, 3vw, 2.25rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--geem-border);
    border-radius: clamp(1.5rem, 3vw, 2rem);
    background:
      radial-gradient(circle at 100% 0%, color-mix(in oklab, var(--geem-sky) 12%, transparent), transparent 42%),
      white;
    box-shadow: 0 20px 60px color-mix(in oklab, var(--geem-navy-950) 6%, transparent);
  }

  .integration-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .integration-item {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem;
    border: 1px solid color-mix(in oklab, var(--geem-navy-900) 9%, white);
    border-radius: 1rem;
    background: var(--geem-surface);
  }

  .integration-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border: 1px solid var(--geem-border);
    border-radius: 0.85rem;
    background: white;
  }

  .integration-icon img {
    inline-size: 2rem;
    block-size: 2rem;
    object-fit: contain;
  }

  .integration-item strong,
  .integration-item small {
    display: block;
  }

  .integration-item strong {
    color: var(--geem-navy-900);
    font-size: 0.9rem;
  }

  .integration-item small {
    margin-block-start: 0.12rem;
    color: var(--geem-muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .system-callout {
    position: relative;
    display: grid;
    grid-column: 1 / -1;
    gap: 1rem;
    align-items: center;
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in oklab, var(--geem-sand) 25%, transparent);
    border-radius: 1.4rem;
    background:
      radial-gradient(circle at 92% 0%, color-mix(in oklab, var(--geem-sky) 20%, transparent), transparent 42%),
      linear-gradient(135deg, var(--geem-navy-950), var(--geem-navy-800));
    color: white;
    box-shadow: 0 20px 45px color-mix(in oklab, var(--geem-navy-950) 18%, transparent);
  }

  .system-callout__icon {
    display: grid;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    place-items: center;
    border: 1px solid color-mix(in oklab, var(--geem-sand) 45%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklab, white 7%, transparent);
    color: var(--geem-sand);
  }

  .system-callout__icon svg {
    inline-size: 2rem;
    block-size: 2rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .system-callout__copy {
    min-width: 0;
  }

  .system-callout__copy > p:first-child {
    color: var(--geem-sand);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .system-callout__copy h3 {
    margin-block-start: 0.3rem;
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .system-callout__copy > p:last-child {
    max-inline-size: 46rem;
    margin-block-start: 0.55rem;
    color: color-mix(in oklab, white 76%, transparent);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .system-callout__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .system-callout__tags li {
    padding: 0.42rem 0.7rem;
    border: 1px solid color-mix(in oklab, white 15%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, white 6%, transparent);
    color: color-mix(in oklab, white 82%, transparent);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .product-ecosystem {
    grid-column: 1 / -1;
    min-inline-size: 0;
    padding-block-start: clamp(1.5rem, 3vw, 2rem);
    border-block-start: 1px solid var(--geem-border);
  }

  .product-ecosystem__heading {
    display: grid;
    gap: 0.8rem;
    align-items: end;
  }

  .product-ecosystem__status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: #226b5d;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .product-ecosystem__status > span {
    flex: none;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 50%;
    background: #278471;
  }

  .product-ecosystem__heading h3 {
    margin-block-start: 0.4rem;
    color: var(--geem-navy-950);
    font-size: clamp(1.25rem, 2.4vw, 1.65rem);
    font-weight: 600;
    line-height: 1.45;
    text-wrap: balance;
  }

  .product-ecosystem__description {
    max-inline-size: 33rem;
    color: var(--geem-muted);
    font-size: 0.88rem;
    line-height: 1.75;
  }

  .product-ecosystem__products {
    display: grid;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ecosystem-product {
    --product-accent: #3465a3;
    --product-fill: #eaf0f8;
    display: flex;
    min-inline-size: 0;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 1rem;
    border: 1px solid var(--geem-border);
    border-block-start: 2px solid var(--product-accent);
    border-radius: 0.65rem;
    background: #fbfcfd;
  }

  .ecosystem-product--platform {
    --product-accent: #27796b;
    --product-fill: #e5f2ed;
  }

  .ecosystem-product--qaf-noon {
    --product-accent: #6c5795;
    --product-fill: #eeeaf5;
  }

  .ecosystem-product__icon {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border-radius: 0.55rem;
    background: var(--product-fill);
    color: var(--product-accent);
  }

  .ecosystem-product__icon svg {
    inline-size: 1.7rem;
    block-size: 1.7rem;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ecosystem-product__copy {
    min-inline-size: 0;
  }

  .ecosystem-product h4 {
    color: var(--geem-navy-950);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .ecosystem-product p {
    margin-block-start: 0.35rem;
    color: var(--geem-muted);
    font-size: 0.8rem;
    line-height: 1.75;
  }

  .product-ecosystem__value {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-block-start: 1rem;
    padding: 0.95rem 1rem;
    border-inline-start: 2px solid #a1c9bd;
    background: #f0f7f4;
  }

  .product-ecosystem__value-icon {
    flex: none;
    color: #27796b;
  }

  .product-ecosystem__value-icon svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-block-start: 0.15rem;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .product-ecosystem__value p {
    min-inline-size: 0;
    color: #4d6862;
    font-size: 0.8rem;
    line-height: 1.8;
  }

  .product-ecosystem__value strong {
    display: block;
    color: #245e52;
    font-weight: 600;
  }

  .product-ecosystem__value p > span {
    display: block;
    margin-block-start: 0.15rem;
  }

  @media (min-width: 760px) {
    .product-ecosystem__products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .product-ecosystem__heading {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 2rem;
    }

    .product-ecosystem__value strong,
    .product-ecosystem__value p > span {
      display: inline;
    }

    .product-ecosystem__value strong {
      margin-inline-end: 0.6rem;
    }
  }

  @media (min-width: 900px) {
    .integration-panel {
      grid-template-columns: minmax(0, 1fr) minmax(24rem, 0.9fr);
    }

    .system-callout {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 1.25rem;
    }

    .system-callout__tags {
      max-inline-size: 13rem;
      justify-content: flex-end;
    }
  }

  @media (max-width: 520px) {
    .integration-list {
      grid-template-columns: 1fr;
    }
  }
</style>
