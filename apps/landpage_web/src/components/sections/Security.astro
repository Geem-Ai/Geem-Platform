---
import type { SiteCopy } from '../../content/site/types';
import type { Locale } from '../../lib/i18n';
import Section from '../ui/Section.astro';
import { localizedPath } from '../../lib/site';

type Props = { locale: Locale; copy: SiteCopy };
const { locale, copy } = Astro.props;
---

<Section id="security-overview" tone="light">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-start lg:gap-14">
    <div data-reveal>
      <p class="eyebrow"><span class="section-number">{copy.security.number}</span> {copy.security.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{copy.security.title}</h2>
      <p class="mt-4 max-w-2xl text-lg text-geem-muted">{copy.security.description}</p>

      <a class="btn btn-ghost mt-6 inline-flex" href={localizedPath(locale, 'security')}>
        {copy.security.linkLabel}
      </a>
    </div>

    <ul class="divide-y divide-geem-border border-y border-geem-border" data-reveal-stagger>
      {
        copy.security.points.map((point) => (
          <li class="flex gap-4 py-5 first:pt-4 last:pb-4">
            <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full bg-geem-navy-900 text-geem-sand" aria-hidden="true">
              <svg class="size-4" viewBox="0 0 20 20" fill="none">
                <path d="m5 10 3 3 7-7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path>
              </svg>
            </span>
            <span>
              <strong class="block font-semibold text-geem-navy-900">{point.title}</strong>
              <span class="mt-1 block text-sm text-geem-muted">{point.description}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
