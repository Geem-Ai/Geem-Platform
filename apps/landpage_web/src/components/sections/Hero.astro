---
import type { SiteCopy } from '../../content/site/types';
import type { Locale } from '../../lib/i18n';
import { Picture, Image } from 'astro:assets';
import hero from '../../assets/landing/riyadh-madinah-hero.webp';
import avatar from '../../assets/brand/geem-avatar.webp';
import Button from '../ui/Button.astro';
import { getSiteConfig } from '../../lib/site';
import { homeHash } from '../../lib/routes';

type Props = {
  locale: Locale;
  copy: SiteCopy;
};

const { locale, copy } = Astro.props;
const { signupUrl } = getSiteConfig();
const questionMark = locale === 'ar' ? '؟' : '?';
const specialtyPhrases = copy.hero.specialties.map((specialty) => `${specialty}${questionMark}`);
const firstSpecialty = specialtyPhrases[0] ?? '';
---

<section class="relative min-h-[min(92vh,56rem)] overflow-hidden text-white" id="product">
  <div class="hero-media">
    <Picture
      src={hero}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600, 1774]}
      sizes="100vw"
      width={1774}
      height={887}
      alt={copy.hero.imageAlt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-grain" aria-hidden="true"></div>
  </div>

  <div class="relative container-shell flex min-h-[min(92vh,56rem)] flex-col justify-center py-24">
    <div class="max-w-3xl" data-typewriter-container>
      <div class="hero-enter hero-enter-1 mb-6 flex items-center gap-3">
        <Image
          src={avatar}
          alt=""
          width={56}
          height={56}
          class="size-14 rounded-full shadow-lg shadow-black/30"
          loading="eager"
          fetchpriority="high"
        />
        <p class="eyebrow !text-geem-sand m-0 min-w-0">{copy.hero.eyebrow}</p>
        <button
          class="hero-typewriter-toggle"
          type="button"
          data-typewriter-toggle
          data-pause-label={copy.a11y.pauseTypewriter}
          data-resume-label={copy.a11y.resumeTypewriter}
          aria-label={copy.a11y.pauseTypewriter}
        >
          <svg data-typewriter-pause viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3.25v9.5M11 3.25v9.5"></path>
          </svg>
          <svg class="is-hidden" data-typewriter-play viewBox="0 0 16 16" aria-hidden="true">
            <path d="m5.25 3.25 7 4.75-7 4.75Z"></path>
          </svg>
        </button>
      </div>

      <h1 class="hero-typewriter-heading hero-enter hero-enter-2 min-w-0 text-balance text-4xl font-semibold leading-tight tracking-tight md:text-5xl lg:text-6xl">
        <span class="visually-hidden">{copy.hero.specialtyPrompt} {firstSpecialty}</span>
        <span class="hero-typewriter-heading-visual" aria-hidden="true">
          <span>{copy.hero.specialtyPrompt}</span>
          <span
            class="hero-typewriter"
            data-typewriter
            data-phrases={JSON.stringify(specialtyPhrases)}
          >
            {
              specialtyPhrases.map((specialty) => (
                <span class="hero-typewriter-measure">{specialty}</span>
              ))
            }
            <span class="hero-typewriter-output">
              <span data-typewriter-text>{firstSpecialty}</span>
              <span class="hero-typewriter-caret" aria-hidden="true"></span>
            </span>
          </span>
        </span>
      </h1>

      <p class="hero-enter hero-enter-3 mt-5 max-w-2xl text-lg text-white/85 md:text-xl">
        {copy.hero.description}
      </p>

      <div class="hero-enter hero-enter-4 mt-8 flex flex-wrap items-center gap-3">
        <Button href={signupUrl} variant="primary">{copy.hero.primaryCta}</Button>
        <Button href={homeHash(locale, 'experts')} variant="ghost">{copy.hero.tertiaryCta}</Button>
      </div>
    </div>
  </div>
</section>
