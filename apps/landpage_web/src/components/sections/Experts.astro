---
import type { SiteCopy } from '../../content/site/types';
import Section from '../ui/Section.astro';
import ExpertFlow from '../diagrams/ExpertFlow.astro';

type Props = { copy: SiteCopy };
const { copy } = Astro.props;
---

<Section id="experts" tone="light">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.82fr)] lg:items-end lg:gap-14">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow"><span class="section-number">{copy.experts.number}</span> {copy.experts.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{copy.experts.title}</h2>
      <p class="mt-4 text-lg text-geem-muted">{copy.experts.description}</p>
    </div>

    <div data-reveal>
      <ul class="divide-y divide-geem-border border-y border-geem-border" data-reveal-stagger>
        {
          copy.experts.cards.slice(0, 3).map((card) => (
            <li class="flex gap-4 py-4">
              <span class="mt-2 size-2 shrink-0 rounded-full bg-geem-blue" aria-hidden="true" />
              <div>
                <h3 class="font-semibold text-geem-navy-900">{card.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-geem-muted">{card.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-sm text-geem-muted">{copy.experts.note}</p>
    </div>
  </div>

  <ExpertFlow copy={copy} />
</Section>
