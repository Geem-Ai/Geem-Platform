---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import type { Locale } from '../../lib/i18n';
import type { LegalPageKey, SiteCopy } from '../../content/site/types';
import { company } from '../../lib/company';
import { localizedPath } from '../../lib/site';
import Button from '../ui/Button.astro';

export type LegalKind = LegalPageKey;

type Props = {
  locale: Locale;
  copy: SiteCopy;
  kind: LegalKind;
};

const { locale, copy, kind } = Astro.props;

const metaMap = {
  privacy: { title: copy.meta.privacyTitle, description: copy.meta.privacyDescription },
  terms: { title: copy.meta.termsTitle, description: copy.meta.termsDescription },
  pdpl: { title: copy.meta.pdplTitle, description: copy.meta.pdplDescription },
} as const;

const meta = metaMap[kind];
const page = copy.legal.pages[kind];
const operator = locale === 'ar' ? company.legalNameAr : company.legalNameEn;
const address = locale === 'ar' ? company.addressAr : company.addressEn;
const contactHref = localizedPath(locale, 'contact');
---

<MarketingLayout locale={locale} copy={copy} title={meta.title} description={meta.description} path={kind}>
  <section class="legal-hero">
    <div class="container-shell legal-hero__grid">
      <div class="legal-hero__copy">
        <p class="legal-eyebrow">{page.hero.eyebrow}</p>
        <h1>{page.hero.title}</h1>
        <p>{page.hero.description}</p>
      </div>

      <dl class="legal-meta">
        <div>
          <dt>{copy.legal.lastUpdatedLabel}</dt>
          <dd><time datetime="2026-08-18">{copy.legal.lastUpdated}</time></dd>
        </div>
        <div>
          <dt>{copy.legal.operatorLabel}</dt>
          <dd>{operator}</dd>
        </div>
        <div>
          <dt>{copy.legal.contactLabel}</dt>
          <dd><a href={`mailto:${company.emails.info}`}><bdi dir="ltr">{company.emails.info}</bdi></a></dd>
        </div>
      </dl>
    </div>
  </section>

  <div class="container-shell legal-highlights-shell">
    <ul class="legal-highlights" aria-label={page.hero.eyebrow}>
      {page.highlights.map((item) => <li><strong>{item.title}</strong><span>{item.description}</span></li>)}
    </ul>
  </div>

  <section class="legal-body">
    <div class="container-shell legal-layout">
      <aside class="legal-sidebar">
        <nav aria-label={copy.legal.contentsLabel}>
          <p>{copy.legal.contentsLabel}</p>
          <ol>
            {
              page.sections.map((section, index) => (
                <li>
                  <a href={`#${section.id}`}>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    {section.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="legal-related">
          <p>{copy.legal.relatedLabel}</p>
          <ul>
            {page.relatedLinks.map((link) => <li><a href={localizedPath(locale, link.href)}>{link.label}</a></li>)}
          </ul>
        </div>
      </aside>

      <article class="legal-document">
        <p class="legal-scope">{page.scopeNotice}</p>
        {
          page.sections.map((section, index) => (
            <section id={section.id}>
              <header>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <h2>{section.title}</h2>
              </header>
              <div class="legal-section-copy">
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
              </div>
            </section>
          ))
        }
      </article>
    </div>
  </section>

  <section class="legal-cta">
    <div class="container-shell legal-cta__grid">
      <div>
        <p class="legal-eyebrow">{copy.legal.contactLabel}</p>
        <h2>{page.cta.title}</h2>
        <p>{page.cta.description}</p>
      </div>
      <div class="legal-cta__actions">
        <Button href={contactHref} variant="primary">{page.cta.label}</Button>
        <a href={`mailto:${company.emails.info}`}><bdi dir="ltr">{company.emails.info}</bdi></a>
      </div>
    </div>
    <p class="container-shell legal-operator-line">{operator} · <bdi dir="ltr">{company.phoneDisplay}</bdi> · {address}</p>
  </section>
</MarketingLayout>

<style>
  .legal-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.75rem, 7vw, 6rem) clamp(6rem, 9vw, 8rem);
    background:
      radial-gradient(circle at 82% 5%, color-mix(in oklab, var(--geem-blue) 30%, transparent), transparent 34%),
      radial-gradient(circle at 8% 0%, color-mix(in oklab, var(--geem-sand) 10%, transparent), transparent 38%),
      linear-gradient(155deg, var(--geem-navy-950), var(--geem-navy-900));
    color: white;
  }

  .legal-hero::before {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(color-mix(in oklab, white 3%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, white 3%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    content: '';
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .legal-hero__grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: end;
  }

  .legal-hero__copy { min-width: 0; }

  .legal-eyebrow {
    color: var(--geem-sand);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.035em;
  }

  .legal-hero h1 {
    max-inline-size: 14ch;
    margin-block-start: 1rem;
    font-size: clamp(2.65rem, 5.5vw, 4.8rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-wrap: balance;
  }

  :global(html[dir='rtl']) .legal-hero h1 {
    max-inline-size: 16ch;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .legal-hero__copy > p:last-child {
    max-inline-size: 44rem;
    margin-block-start: 1.35rem;
    color: color-mix(in oklab, white 74%, transparent);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.8;
  }

  .legal-meta {
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, white 14%, transparent);
    border-radius: 1.5rem;
    background: color-mix(in oklab, white 6%, transparent);
    backdrop-filter: blur(12px);
  }

  .legal-meta > div {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.15rem;
  }

  .legal-meta > div + div { border-block-start: 1px solid color-mix(in oklab, white 12%, transparent); }
  .legal-meta dt { color: color-mix(in oklab, white 50%, transparent); font-size: 0.72rem; }
  .legal-meta dd { margin: 0; color: white; font-size: 0.88rem; font-weight: 500; line-height: 1.5; }
  .legal-meta a { color: inherit; text-underline-offset: 0.2em; }

  .legal-highlights-shell { position: relative; z-index: 3; margin-block-start: -3.25rem; }

  .legal-highlights {
    display: grid;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--geem-border);
    border-radius: 1.5rem;
    background: white;
    box-shadow: 0 22px 60px color-mix(in oklab, var(--geem-navy-950) 10%, transparent);
    list-style: none;
  }

  .legal-highlights li { display: grid; gap: 0.35rem; padding: 1.3rem 1.4rem; }
  .legal-highlights li + li { border-block-start: 1px solid var(--geem-border); }
  .legal-highlights strong { color: var(--geem-navy-900); font-size: 0.95rem; }
  .legal-highlights span { color: var(--geem-muted); font-size: 0.78rem; line-height: 1.65; }

  .legal-body { padding-block: clamp(4rem, 8vw, 7rem); background: var(--geem-surface); }
  .legal-layout { display: grid; gap: 2rem; align-items: start; }
  .legal-sidebar { display: grid; gap: 1rem; min-width: 0; }

  .legal-sidebar nav,
  .legal-related {
    overflow: hidden;
    border: 1px solid var(--geem-border);
    border-radius: 1.25rem;
    background: white;
  }

  .legal-sidebar nav > p,
  .legal-related > p {
    margin: 0;
    padding: 1rem 1.1rem;
    border-block-end: 1px solid var(--geem-border);
    color: var(--geem-navy-900);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .legal-sidebar ol,
  .legal-sidebar ul { margin: 0; padding: 0; list-style: none; }

  .legal-sidebar a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    padding: 0.7rem 1.1rem;
    color: var(--geem-muted);
    font-size: 0.78rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .legal-sidebar a:hover,
  .legal-sidebar a:focus-visible { background: color-mix(in oklab, var(--geem-sky) 7%, white); color: var(--geem-navy-900); }
  .legal-sidebar a span { color: var(--geem-blue); font-variant-numeric: tabular-nums; font-weight: 600; }
  .legal-related a { grid-template-columns: 1fr auto; }
  .legal-related a::after { color: var(--geem-blue); content: '↗'; }
  :global(html[dir='rtl']) .legal-related a::after { transform: scaleX(-1); }

  .legal-document {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--geem-border);
    border-radius: 1.75rem;
    background: white;
    box-shadow: 0 22px 70px color-mix(in oklab, var(--geem-navy-950) 6%, transparent);
  }

  .legal-scope {
    margin: 0;
    padding: clamp(1.25rem, 4vw, 2rem);
    border-block-end: 1px solid var(--geem-border);
    background: color-mix(in oklab, var(--geem-sand) 28%, white);
    color: var(--geem-navy-900);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.75;
  }

  .legal-document > section {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.5rem, 4vw, 2.4rem);
    scroll-margin-block-start: 6.5rem;
  }

  .legal-document > section + section { border-block-start: 1px solid var(--geem-border); }
  .legal-document header { display: grid; grid-template-columns: auto 1fr; gap: 0.85rem; align-items: start; }

  .legal-document header > span {
    display: grid;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    place-items: center;
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--geem-sky) 12%, white);
    color: var(--geem-blue);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .legal-document h2 {
    color: var(--geem-navy-900);
    font-size: clamp(1.25rem, 2.5vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  :global(html[dir='rtl']) .legal-document h2 { letter-spacing: 0; line-height: 1.55; }
  .legal-section-copy { max-inline-size: 70ch; }
  .legal-section-copy p { margin: 0; color: var(--geem-muted); line-height: 1.9; }
  .legal-section-copy p + p { margin-block-start: 0.9rem; }
  .legal-section-copy ul { display: grid; gap: 0.65rem; margin: 1rem 0 0; padding: 0; list-style: none; }

  .legal-section-copy li {
    position: relative;
    padding-inline-start: 1.25rem;
    color: var(--geem-muted);
    line-height: 1.75;
  }

  .legal-section-copy li::before {
    position: absolute;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 50%;
    background: var(--geem-sky);
    content: '';
    inset-block-start: 0.72rem;
    inset-inline-start: 0;
  }

  .legal-cta { padding-block: clamp(3rem, 6vw, 5rem); background: var(--geem-sand); }
  .legal-cta__grid { display: grid; gap: 2rem; align-items: end; }
  .legal-cta .legal-eyebrow { color: var(--geem-blue); }

  .legal-cta h2 {
    max-inline-size: 20ch;
    margin-block-start: 0.7rem;
    color: var(--geem-navy-950);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-wrap: balance;
  }

  :global(html[dir='rtl']) .legal-cta h2 { letter-spacing: 0; line-height: 1.3; }
  .legal-cta__grid > div:first-child > p:last-child { max-inline-size: 42rem; margin-block-start: 0.9rem; color: color-mix(in oklab, var(--geem-navy-900) 74%, transparent); }
  .legal-cta__actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .legal-cta__actions :global(.btn-primary) { background: var(--geem-navy-950); color: white; }
  .legal-cta__actions > a { color: var(--geem-navy-900); font-weight: 600; text-underline-offset: 0.22em; }

  .legal-operator-line {
    margin-block-start: 2.25rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid color-mix(in oklab, var(--geem-navy-900) 18%, transparent);
    color: color-mix(in oklab, var(--geem-navy-900) 68%, transparent);
    font-size: 0.75rem;
  }

  @media (min-width: 48rem) {
    .legal-hero__grid { grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.45fr); }
    .legal-highlights { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .legal-highlights li + li { border-block-start: 0; border-inline-start: 1px solid var(--geem-border); }
    .legal-cta__grid { grid-template-columns: minmax(0, 1fr) auto; }
    .legal-cta__actions { justify-content: flex-end; }
  }

  @media (min-width: 64rem) {
    .legal-layout { grid-template-columns: minmax(14rem, 0.32fr) minmax(0, 1fr); gap: 2.25rem; }
    .legal-sidebar { position: sticky; top: 6.5rem; max-block-size: calc(100vh - 8rem); overflow: auto; }
    .legal-document > section { grid-template-columns: minmax(13rem, 0.42fr) minmax(0, 1fr); gap: 2rem; }
  }

  @media (max-width: 36rem) {
    .legal-hero { padding-block-start: 3.5rem; }
    .legal-sidebar nav ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .legal-sidebar nav li:nth-child(odd):last-child { grid-column: 1 / -1; }
    .legal-sidebar a { block-size: 100%; border-block-end: 1px solid var(--geem-border); }
    .legal-cta__actions { display: grid; }
    .legal-cta__actions :global(.btn) { inline-size: 100%; }
  }

  @media print {
    :global(.site-header),
    :global(.site-footer),
    .legal-sidebar,
    .legal-highlights-shell,
    .legal-cta { display: none !important; }
    .legal-hero { padding-block: 1rem; background: white; color: black; }
    .legal-hero::before { display: none; }
    .legal-hero__grid,
    .legal-layout { display: block; }
    .legal-hero__copy > p,
    .legal-meta dt,
    .legal-meta dd { color: black !important; }
    .legal-meta,
    .legal-document { border: 0; box-shadow: none; }
    .legal-body { padding-block: 1rem; background: white; }
    .legal-document > section { break-inside: avoid; }
  }
</style>
