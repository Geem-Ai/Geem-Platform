---
import { getPlatformFoundationCopy } from '../../content/platform-foundation';
import type { Locale } from '../../lib/i18n';

type Props = { locale: Locale };
const { locale } = Astro.props;
const copy = getPlatformFoundationCopy(locale);
const titleId = `platform-title-${locale}`;
---

<section id="platform" class="platform-foundation section-shell" aria-labelledby={titleId}>
  <div class="container-shell">
    <header class="platform-header">
      <div class="platform-header__copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2 id={titleId}>{copy.title}</h2>
        <p class="platform-header__description">{copy.description}</p>
      </div>
      <aside class="platform-infrastructure" aria-label={copy.infrastructureLabel}>
        <span class="platform-infrastructure__icon" aria-hidden="true">
          <svg viewBox="0 0 32 32"><rect x="6" y="5" width="20" height="9" rx="2" /><rect x="6" y="18" width="20" height="9" rx="2" /><path d="M11 9.5h.01M11 22.5h.01M17 9.5h4M17 22.5h4" /></svg>
        </span>
        <div>
          <p class="platform-infrastructure__label">{copy.infrastructureLabel}</p>
          <h3>{copy.infrastructureTitle}</h3>
          <p class="platform-infrastructure__description">{copy.infrastructureDescription}</p>
        </div>
      </aside>
    </header>

    <figure class="platform-diagram" aria-label={copy.diagramLabel}>
      <ol class="platform-layers" role="list">
        <li class="platform-models">
          <span class="platform-models__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="m24 7 17 9-17 9L7 16 24 7Zm-17 17 17 9 17-9M7 32l17 9 17-9" /></svg>
          </span>
          <div class="platform-models__copy">
            <p class="platform-layer-label">{copy.modelsLabel}</p>
            <h3>{copy.modelsTitle}</h3>
          </div>
          <p class="platform-models__description">{copy.modelsDescription}</p>
        </li>

        <li>
          <div class="platform-flow" aria-hidden="true"><svg viewBox="0 0 32 34"><path d="M16 0v28m-5-5 5 5 5-5" /></svg></div>
          <div class="platform-core">
            <div class="platform-core__heading">
              <span class="platform-wordmark" lang="en" dir="ltr">GEEM</span>
              <div>
                <p class="platform-layer-label">{copy.platformLabel}</p>
                <h3>{copy.platformTitle}</h3>
              </div>
            </div>
            <p class="platform-core__description">{copy.platformDescription}</p>
            <ul class="platform-controls" role="list">
              {copy.controls.map((control) => <li><span aria-hidden="true"></span>{control}</li>)}
            </ul>
          </div>
        </li>

        <li>
          <div class="platform-flow platform-flow--branch" aria-hidden="true">
            <svg viewBox="0 0 900 42" preserveAspectRatio="none"><path d="M450 0v16M150 38V16h600v22M450 16v22" /><circle cx="150" cy="39" r="2" /><circle cx="450" cy="39" r="2" /><circle cx="750" cy="39" r="2" /></svg>
          </div>
          <div class="platform-flow platform-flow--mobile" aria-hidden="true"><svg viewBox="0 0 32 34"><path d="M16 0v28m-5-5 5 5 5-5" /></svg></div>
          <ul class="platform-outputs" role="list">
            {copy.outputs.map((output) => (
              <li class={`platform-output platform-output--${output.id}`}>
                <span class="platform-output__icon" aria-hidden="true">
                  <svg viewBox="0 0 28 28">
                    {output.id === 'general' && <path d="m14 4 2.5 7.5L24 14l-7.5 2.5L14 24l-2.5-7.5L4 14l7.5-2.5L14 4Z" />}
                    {output.id === 'experts' && <><path d="M14 7c-3-2-6-2-10-1v16c4-1 7-1 10 1 3-2 6-2 10-1V6c-4-1-7-1-10 1Zm0 0v16M8 10h2M8 14h2M18 10h2M18 14h2" /></>}
                    {output.id === 'actions' && <><rect x="3" y="9" width="6" height="10" rx="2" /><rect x="19" y="9" width="6" height="10" rx="2" /><path d="M9 14h10m-4-4 4 4-4 4" /></>}
                  </svg>
                </span>
                <div><h4>{output.title}</h4><p>{output.description}</p></div>
              </li>
            ))}
          </ul>
        </li>
      </ol>
      <figcaption>{copy.note}</figcaption>
    </figure>

    <ul class="platform-values" aria-label={copy.valuesLabel} role="list">
      {copy.values.map((value, index) => <li><span aria-hidden="true">0{index + 1}</span><p>{value}</p></li>)}
    </ul>
  </div>
</section>

<style>
  .platform-foundation { background: #edf3f8; color: var(--geem-navy-950); border-block: 1px solid #dae4ee; }
  .platform-header { display: grid; gap: 2rem; align-items: end; }
  .platform-header__copy { max-inline-size: 43rem; min-inline-size: 0; }
  .platform-header h2 { margin-block-start: 0.75rem; font-size: clamp(1.9rem, 3.8vw, 2.8rem); font-weight: 600; line-height: 1.3; letter-spacing: -0.025em; text-wrap: balance; }
  .platform-header__description { max-inline-size: 38rem; margin-block-start: 1rem; color: var(--geem-muted); font-size: 1.05rem; line-height: 1.8; }
  .platform-infrastructure { display: flex; align-items: flex-start; gap: 0.9rem; padding: 1.2rem; border-inline-start: 3px solid #46a898; background: #e0eeea; }
  .platform-infrastructure__icon { display: grid; flex: none; place-items: center; inline-size: 2.5rem; block-size: 2.5rem; color: #256f66; }
  .platform-infrastructure__icon svg { inline-size: 2.1rem; block-size: 2.1rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .platform-infrastructure__label { color: #356b63; font-size: 0.72rem; font-weight: 600; }
  .platform-infrastructure h3 { margin-block-start: 0.3rem; font-size: 1rem; font-weight: 600; line-height: 1.5; }
  .platform-infrastructure__description { margin-block-start: 0.35rem; color: #516b68; font-size: 0.8rem; line-height: 1.7; }
  .platform-diagram { margin: clamp(2rem, 4vw, 3rem) 0 0; }
  .platform-layers, .platform-controls, .platform-outputs, .platform-values { list-style: none; padding: 0; margin: 0; }
  .platform-layers > li { min-inline-size: 0; }
  .platform-models { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; padding: 1.25rem clamp(1.1rem, 3vw, 2rem); border: 1px solid #d3deeb; border-radius: 1rem; background: #f9fbff; }
  .platform-models__icon { display: grid; flex: none; place-items: center; inline-size: 3.1rem; block-size: 3.1rem; color: #4569b0; background: #e9effb; border-radius: 0.75rem; }
  .platform-models__icon svg { inline-size: 2.1rem; block-size: 2.1rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .platform-models__copy { flex: 1; min-inline-size: 10rem; }
  .platform-layer-label { color: #63758c; font-size: 0.72rem; font-weight: 500; }
  .platform-models h3 { margin-block-start: 0.2rem; font-size: clamp(1.1rem, 2vw, 1.3rem); font-weight: 600; line-height: 1.5; }
  .platform-models__description { max-inline-size: 18rem; color: var(--geem-muted); font-size: 0.86rem; line-height: 1.7; }
  .platform-flow { display: flex; justify-content: center; block-size: 2.1rem; color: #98aec3; }
  .platform-flow svg { display: block; inline-size: 2rem; block-size: 100%; overflow: visible; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .platform-core { padding: clamp(1.4rem, 3vw, 2.1rem); border: 1px solid #173f59; border-radius: 1rem; background: var(--geem-navy-900); color: white; }
  .platform-core__heading { display: flex; flex-wrap: wrap; align-items: center; gap: 1.15rem; }
  .platform-wordmark { display: grid; flex: none; place-items: center; inline-size: 4.7rem; block-size: 3.8rem; border: 1px solid #ffffff29; border-radius: 0.65rem; color: #b7e6d9; font-size: 1rem; font-weight: 700; letter-spacing: 0.04em; }
  .platform-core .platform-layer-label { color: #abd2d6; }
  .platform-core h3 { margin-block-start: 0.15rem; font-size: clamp(1.25rem, 2.7vw, 1.7rem); font-weight: 600; line-height: 1.4; }
  .platform-core__description { margin-block-start: 1rem; color: #cfdee8; font-size: 0.94rem; line-height: 1.75; }
  .platform-controls { display: grid; gap: 0.85rem; margin-block-start: 1.4rem; padding-block-start: 1.1rem; border-block-start: 1px solid #ffffff25; }
  .platform-controls li { display: flex; min-inline-size: 0; align-items: center; gap: 0.55rem; color: #e0eaf0; font-size: 0.82rem; line-height: 1.6; }
  .platform-controls li span { flex: none; inline-size: 0.4rem; block-size: 0.4rem; border-radius: 50%; background: #8fd3c0; }
  .platform-controls li:nth-child(2) span { background: #a9bdf4; }
  .platform-controls li:nth-child(3) span { background: #c9baf0; }
  .platform-flow--branch { display: none; block-size: 2.6rem; }
  .platform-flow--branch svg { inline-size: 100%; }
  .platform-flow--branch circle { fill: #98aec3; stroke: none; }
  .platform-outputs { display: grid; gap: 0.75rem; }
  .platform-output { --output-accent: #3865b2; --output-fill: #e5edfc; display: flex; align-items: flex-start; gap: 0.9rem; min-inline-size: 0; padding: 1.15rem; border: 1px solid #d9e1eb; border-block-start: 3px solid var(--output-accent); border-radius: 0.7rem; background: #fff; }
  .platform-output--experts { --output-accent: #268474; --output-fill: #e3f2ec; }
  .platform-output--actions { --output-accent: #8065b0; --output-fill: #eee9f7; }
  .platform-output__icon { display: grid; flex: none; place-items: center; inline-size: 2.5rem; block-size: 2.5rem; border-radius: 0.65rem; color: var(--output-accent); background: var(--output-fill); }
  .platform-output__icon svg { inline-size: 1.45rem; block-size: 1.45rem; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .platform-output h4 { font-size: 1rem; font-weight: 600; line-height: 1.5; }
  .platform-output p { margin-block-start: 0.5rem; color: var(--geem-muted); font-size: 0.82rem; line-height: 1.75; }
  .platform-diagram figcaption { margin-block-start: 1.1rem; color: #5a6e83; font-size: 0.82rem; line-height: 1.8; text-align: center; }
  .platform-values { display: grid; gap: 1.1rem; margin-block-start: 2rem; padding-block-start: 1.5rem; border-block-start: 1px solid #d1dde8; }
  .platform-values li { display: flex; align-items: baseline; gap: 0.8rem; min-inline-size: 0; }
  .platform-values span { flex: none; color: #3c6cb2; font-size: 0.73rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .platform-values li:nth-child(2) span { color: #268474; }
  .platform-values li:nth-child(3) span { color: #8065b0; }
  .platform-values p { color: #425b70; font-size: 0.88rem; line-height: 1.75; }
  @media (min-width: 700px) {
    .platform-controls, .platform-outputs, .platform-values { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .platform-flow--branch { display: flex; }
    .platform-flow--mobile { display: none; }
    .platform-output { flex-direction: column; padding: 1.35rem; }
    .platform-values { gap: 1.75rem; }
  }
  @media (min-width: 1000px) {
    .platform-header { grid-template-columns: minmax(0, 1.65fr) minmax(0, 0.9fr); gap: 3rem; }
  }
  @media (max-width: 479px) {
    .platform-models__description { flex-basis: 100%; max-inline-size: none; }
    .platform-core__heading { align-items: flex-start; }
    .platform-wordmark { inline-size: 4rem; block-size: 3.3rem; }
  }
</style>
