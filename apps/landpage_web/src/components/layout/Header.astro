---
import type { Locale } from '../../lib/i18n';
import type { SiteCopy } from '../../content/site/types';
import { homeHash } from '../../lib/routes';
import { contactHref, getSiteConfig, localizedPath } from '../../lib/site';
import { otherLocale } from '../../lib/i18n';
import { switchLocalePath } from '../../lib/routes';
import Button from '../ui/Button.astro';
import logo from '../../assets/brand/geem-logo-horizontal-white.svg?raw';

type Props = {
  locale: Locale;
  copy: SiteCopy;
  pathname: string;
};

const { locale, copy, pathname } = Astro.props;
const { signupUrl, loginUrl } = getSiteConfig();
const nextLocale = otherLocale(locale);
const langHref = switchLocalePath(locale, nextLocale, pathname);

function navHref(item: SiteCopy['nav']['items'][number]) {
  if (item.href === 'security') return localizedPath(locale, 'security');
  if (item.href === 'contact') return contactHref(locale);
  return homeHash(locale, item.href === 'product' ? 'product' : item.href);
}

function isCurrentNav(item: SiteCopy['nav']['items'][number]) {
  const current = pathname.replace(/\/$/, '');
  if (item.href === 'security') return current === localizedPath(locale, 'security');
  return false;
}
---

<header class="site-header navigation-header" data-site-header>
  <div class="container-shell navigation-shell">
    <a href={localizedPath(locale)} class="navigation-brand" aria-label={copy.brand.product}>
      <span class="navigation-wordmark" aria-hidden="true" set:html={logo}></span>
    </a>

    <nav class="desktop-navigation" aria-label={copy.a11y.primaryNavigation}>
      {
        copy.nav.items.map((item) => (
          <a href={navHref(item)} aria-current={isCurrentNav(item) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="navigation-actions">
      <a class="language-control" href={langHref} hreflang={nextLocale} lang={nextLocale} dir="auto">
        {copy.a11y.languageSwitch}
      </a>
      <a class="navigation-login" href={loginUrl}>{copy.nav.login}</a>
      <Button href={signupUrl} variant="primary" class="navigation-signup">{copy.nav.primaryCta}</Button>
    </div>

    <button
      type="button"
      class="menu-trigger"
      data-menu-button
      data-close-label={copy.a11y.closeMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={copy.a11y.openMenu}
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
      </svg>
      <span class="visually-hidden">{copy.a11y.openMenu}</span>
    </button>
  </div>

  <dialog id="mobile-menu" data-mobile-menu aria-label={copy.a11y.mobileNavigation} class="mobile-menu">
    <div class="mobile-menu__top">
      <span class="mobile-menu__brand" aria-hidden="true" set:html={logo}></span>
      <button type="button" data-menu-close class="menu-close">
        <span>{copy.a11y.closeMenu}</span>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <nav class="mobile-navigation" aria-label={copy.a11y.mobileNavigation}>
      {
        copy.nav.items.map((item) => (
          <a href={navHref(item)} aria-current={isCurrentNav(item) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mobile-menu__utility">
      <a href={langHref} hreflang={nextLocale} lang={nextLocale} dir="auto">{copy.a11y.languageSwitch}</a>
      <a href={loginUrl}>{copy.nav.login}</a>
    </div>
    <Button href={signupUrl} variant="primary" class="mobile-menu__signup">{copy.nav.primaryCta}</Button>
  </dialog>
</header>

<style>
  .navigation-header,
  .navigation-header.is-scrolled {
    padding-block: 0.85rem;
    border-block-end: 1px solid rgb(255 255 255 / 11%);
    background: var(--geem-navy-950);
    color: white;
    backdrop-filter: none;
  }

  .navigation-shell {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-block-size: 2.75rem;
  }

  .navigation-brand {
    display: inline-flex;
    flex: none;
    padding-block: 0.3rem;
    color: white;
  }

  .navigation-wordmark {
    display: block;
    inline-size: 7.25rem;
    aspect-ratio: 300 / 71.94;
  }

  .navigation-wordmark :global(svg),
  .mobile-menu__brand :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .desktop-navigation,
  .navigation-actions {
    display: none;
  }

  .desktop-navigation a,
  .navigation-login,
  .language-control {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    border-block-end: 1px solid transparent;
    color: rgb(255 255 255 / 78%);
    font-size: 0.875rem;
    line-height: 1.35;
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .desktop-navigation a:hover,
  .desktop-navigation a:focus-visible,
  .desktop-navigation a[aria-current='page'],
  .navigation-login:hover,
  .navigation-login:focus-visible,
  .language-control:hover,
  .language-control:focus-visible {
    border-block-end-color: var(--geem-sand);
    color: white;
  }

  .language-control {
    padding-inline: 0.4rem;
    font-size: 0.8rem;
  }

  .navigation-actions :global(.navigation-signup) {
    min-block-size: 2.75rem;
    padding: 0.65rem 1rem;
    border-radius: 0.55rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .menu-trigger,
  .menu-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2.75rem;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 0.55rem;
    background: transparent;
    color: white;
    cursor: pointer;
  }

  .menu-trigger {
    inline-size: 2.75rem;
    margin-inline-start: auto;
  }

  .menu-trigger svg { inline-size: 1.25rem; block-size: 1.25rem; }
  .menu-trigger:hover,
  .menu-close:hover { background: rgb(255 255 255 / 7%); }

  .mobile-menu {
    inline-size: min(25rem, calc(100% - 2rem));
    max-block-size: calc(100dvh - 2rem);
    margin-block: 1rem auto;
    margin-inline: auto 1rem;
    padding: 1.25rem;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 0.85rem;
    background: var(--geem-navy-950);
    color: white;
    overflow-y: auto;
  }

  .mobile-menu::backdrop { background: rgb(3 13 21 / 65%); }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 1rem;
    border-block-end: 1px solid rgb(255 255 255 / 14%);
  }

  .mobile-menu__brand { display: block; inline-size: 5.5rem; aspect-ratio: 300 / 71.94; }
  .menu-close { gap: 0.5rem; padding-inline: 0.7rem; font-size: 0.75rem; }
  .menu-close svg { inline-size: 1rem; block-size: 1rem; }
  .mobile-navigation { display: grid; gap: 0.15rem; padding-block: 0.9rem; }

  .mobile-navigation a {
    padding: 0.65rem 0.5rem;
    border-radius: 0.35rem;
    color: rgb(255 255 255 / 88%);
    text-decoration: none;
  }

  .mobile-navigation a:hover,
  .mobile-navigation a:focus-visible,
  .mobile-navigation a[aria-current='page'] { background: rgb(255 255 255 / 7%); color: white; }

  .mobile-menu__utility {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem 1.15rem;
    border-block-start: 1px solid rgb(255 255 255 / 14%);
    font-size: 0.875rem;
  }

  .mobile-menu__utility a { color: rgb(255 255 255 / 82%); text-underline-offset: 0.3em; }
  .mobile-menu :global(.mobile-menu__signup) { inline-size: 100%; border-radius: 0.55rem; }

  @media (min-width: 1024px) {
    .navigation-shell { gap: clamp(1.25rem, 2vw, 2rem); }
    .desktop-navigation { display: flex; align-items: center; gap: clamp(0.85rem, 1.45vw, 1.5rem); }
    .navigation-actions { display: flex; align-items: center; gap: 1rem; margin-inline-start: auto; }
    .menu-trigger { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .desktop-navigation a,
    .navigation-login,
    .language-control { transition: none; }
  }
</style>
