---
import type { Locale } from '../../lib/i18n';
import { buildSeo } from '../../lib/seo';

type Props = {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
};

const {
  locale,
  title,
  description,
  path = '',
  ogImage,
  ogImageAlt,
  ogImageType,
  ogImageWidth,
  ogImageHeight,
} = Astro.props;
const seo = buildSeo({
  locale,
  title,
  description,
  path,
  ogImage,
  ogImageAlt,
  ogImageType,
  ogImageWidth,
  ogImageHeight,
});
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
<link rel="canonical" href={seo.canonical} />
<link rel="alternate" hreflang="ar" href={seo.alternateAr} />
<link rel="alternate" hreflang="en" href={seo.alternateEn} />
<link rel="alternate" hreflang="x-default" href={seo.xDefault} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Geem" />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.ogImage} />
<meta property="og:image:secure_url" content={seo.ogImage} />
<meta property="og:image:type" content={seo.ogImageType} />
<meta property="og:image:width" content={String(seo.ogImageWidth)} />
<meta property="og:image:height" content={String(seo.ogImageHeight)} />
<meta property="og:image:alt" content={seo.ogImageAlt} />
<meta property="og:locale" content={seo.ogLocale} />
<meta property="og:locale:alternate" content={seo.ogLocaleAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.ogImage} />
<meta name="twitter:image:alt" content={seo.ogImageAlt} />
