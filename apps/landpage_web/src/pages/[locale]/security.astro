---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getSiteCopy } from '../../content/site';
import { isLocale, localeStaticPaths } from '../../lib/i18n';
import SecurityPage from '../../components/sections/SecurityPage.astro';

export function getStaticPaths() {
  return localeStaticPaths();
}

const raw = Astro.params.locale;
if (!isLocale(raw)) return Astro.redirect('/ar', 302);
const locale = raw;
const copy = getSiteCopy(locale);
---

<MarketingLayout
  locale={locale}
  copy={copy}
  title={copy.meta.securityTitle}
  description={copy.meta.securityDescription}
  path="security"
>
  <SecurityPage locale={locale} copy={copy.security.page} />
</MarketingLayout>
