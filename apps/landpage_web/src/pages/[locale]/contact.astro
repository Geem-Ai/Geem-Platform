---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getSiteCopy } from '../../content/site';
import { getContactCopy } from '../../content/contact';
import { isLocale, localeStaticPaths } from '../../lib/i18n';
import { company } from '../../lib/company';
import { getSiteConfig } from '../../lib/site';
import whatsappIcon from '../../assets/apps/whatsapp.svg';

export function getStaticPaths() {
  return localeStaticPaths();
}

const raw = Astro.params.locale;
if (!isLocale(raw)) return Astro.redirect('/ar', 302);
const locale = raw;
const copy = getSiteCopy(locale);
const contact = getContactCopy(locale);
const { loginUrl } = getSiteConfig();
const address = locale === 'ar' ? company.addressAr : company.addressEn;
---

<MarketingLayout
  locale={locale}
  copy={copy}
  title={copy.meta.contactTitle}
  description={copy.meta.contactDescription}
  path="contact"
>
  <section class="contact-page" aria-labelledby="contact-title">
    <div class="container-shell">
      <header class="contact-intro">
        <div>
          <p class="contact-eyebrow"><span aria-hidden="true"></span>{contact.eyebrow}</p>
          <h1 id="contact-title">{contact.title}</h1>
        </div>
        <p class="contact-introduction">{contact.introduction}</p>
      </header>

      <div class="contact-primary">
        <section class="contact-sales" aria-labelledby="sales-title">
          <div class="sales-heading">
            <span class="contact-icon sales-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg>
            </span>
            <p class="contact-eyebrow">{contact.salesEyebrow}</p>
          </div>
          <h2 id="sales-title">{contact.salesTitle}</h2>
          <p class="sales-description">{contact.salesDescription}</p>
          <a class="sales-email" href={`mailto:${company.emails.sales}`}>
            <span><span class="sales-email-label">{contact.emailSales}</span><bdi dir="ltr">{company.emails.sales}</bdi></span>
            <svg class="direction-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
          </a>
          <div class="inquiry-guide">
            <h3>{contact.checklistTitle}</h3>
            <ul>
              {contact.checklist.map((item) => (
                <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg><span>{item}</span></li>
              ))}
            </ul>
          </div>
        </section>

        <div class="contact-direct">
          <a class="direct-card whatsapp-card" href={company.whatsappUrl}>
            <span class="contact-icon whatsapp-icon" aria-hidden="true"><img src={whatsappIcon.src} alt="" width="30" height="30" /></span>
            <div class="direct-card-copy">
              <h2>{contact.whatsappTitle}</h2>
              <p>{contact.whatsappDescription}</p>
              <span class="direct-action">{contact.whatsappAction}<svg class="direction-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></span>
            </div>
          </a>
          <a class="direct-card phone-card" href={`tel:${company.phoneTel}`}>
            <span class="contact-icon phone-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m7 3 3 5-2 2c1.4 2.6 3.4 4.6 6 6l2-2 5 3-1 4C10 23 1 14 3 4l4-1Z"/></svg>
            </span>
            <div class="direct-card-copy">
              <h2>{contact.phoneTitle}</h2>
              <p>{contact.phoneDescription}</p>
              <span class="phone-number"><bdi dir="ltr">{company.phoneDisplay}</bdi><svg class="direction-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></span>
            </div>
          </a>
        </div>
      </div>

      <div class="contact-secondary">
        <section class="customer-contact" aria-labelledby="customer-title">
          <p class="contact-eyebrow">{contact.customerEyebrow}</p>
          <h2 id="customer-title">{contact.customerTitle}</h2>
          <p>{contact.customerDescription}</p>
          <a class="workspace-link" href={loginUrl}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            {contact.login}
            <svg class="direction-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
          </a>
        </section>
        <section class="general-contact" aria-labelledby="general-title">
          <span class="secondary-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7A8.4 8.4 0 0 1 4 11.5a8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/><path d="M8 11h8m-8 4h4"/></svg></span>
          <h2 id="general-title">{contact.generalTitle}</h2>
          <p>{contact.generalDescription}</p>
          <a class="general-email" href={`mailto:${company.emails.info}`}><bdi dir="ltr">{company.emails.info}</bdi><svg class="direction-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
        </section>
        <section class="company-contact" aria-labelledby="company-title">
          <span class="secondary-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
          <h2 id="company-title">{contact.companyTitle}</h2>
          <p>{contact.companyDescription}</p>
          <address>{address}</address>
        </section>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .contact-page { padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3.5rem, 6vw, 5.5rem); background: var(--geem-surface); }
  .contact-intro { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .85fr); align-items: end; gap: 3rem; margin-block-end: 2.25rem; }
  .contact-eyebrow { display: flex; align-items: center; gap: .6rem; margin: 0 0 .65rem; font-size: .8rem; font-weight: 700; color: var(--geem-blue); }
  .contact-eyebrow > span { width: 1.75rem; height: 2px; background: currentColor; }
  h1 { margin: 0; max-width: 18ch; font-size: clamp(2.1rem, 3.7vw, 3rem); line-height: 1.16; letter-spacing: -.035em; font-weight: 600; text-wrap: balance; }
  .contact-introduction { margin: 0 0 .3rem; color: var(--geem-muted); font-size: 1.04rem; line-height: 1.8; }
  .contact-primary { display: grid; grid-template-columns: minmax(0, 1.14fr) minmax(0, 1fr); gap: 1.25rem; }
  .contact-sales { padding: 2rem; border: 1px solid var(--geem-navy-900); border-radius: 1rem; color: #fff; background: var(--geem-navy-900); }
  .sales-heading { display: flex; align-items: center; gap: .8rem; margin-block-end: 1.1rem; }
  .sales-heading .contact-eyebrow { margin: 0; color: var(--geem-sand); }
  .contact-icon { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 3.2rem; height: 3.2rem; border-radius: .8rem; }
  .contact-icon svg { width: 1.55rem; height: 1.55rem; }
  .sales-icon { width: 2.6rem; height: 2.6rem; border: 1px solid #ffffff26; color: var(--geem-sand); background: #ffffff08; }
  .contact-sales h2 { margin: 0; font-size: clamp(1.4rem, 2.1vw, 1.7rem); font-weight: 600; line-height: 1.35; }
  .sales-description { margin: .6rem 0 1.45rem; max-width: 48ch; font-size: .97rem; line-height: 1.75; color: #d4e1e9; }
  .sales-email { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 5rem; padding: .85rem 1.15rem; border: 1px solid var(--geem-sand); border-radius: .6rem; color: var(--geem-navy-950); background: var(--geem-sand); text-decoration: none; transition: background 180ms ease, border-color 180ms ease; }
  .sales-email > span { display: flex; flex-direction: column; min-width: 0; gap: .1rem; }
  .sales-email-label { font-size: .8rem; font-weight: 600; }
  .sales-email bdi { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
  .sales-email:hover { background: #b8ebdf; border-color: #b8ebdf; }
  .direction-arrow { width: 1.25rem; height: 1.25rem; flex: 0 0 auto; }
  .inquiry-guide { margin-block-start: 1.55rem; padding-block-start: 1.2rem; border-block-start: 1px solid #ffffff26; }
  .inquiry-guide h3 { margin: 0 0 .65rem; font-size: .87rem; font-weight: 600; color: #fff; }
  .inquiry-guide ul { margin: 0; padding: 0; display: grid; gap: .35rem; list-style: none; }
  .inquiry-guide li { display: flex; align-items: start; gap: .65rem; font-size: .88rem; line-height: 1.65; color: #d4e1e9; }
  .inquiry-guide li svg { width: 1rem; height: 1rem; margin-block-start: .2rem; flex: 0 0 auto; color: var(--geem-sand); }
  .contact-direct { display: grid; grid-template-rows: 1fr 1fr; gap: 1.25rem; }
  .direct-card { display: flex; align-items: start; gap: 1.2rem; padding: 1.8rem; border: 1px solid var(--geem-border); border-radius: 1rem; text-decoration: none; color: var(--geem-navy-950); transition: border-color 180ms ease, box-shadow 180ms ease; }
  .direct-card-copy { min-width: 0; }
  .direct-card h2 { margin: 0 0 .35rem; font-size: 1.27rem; font-weight: 600; line-height: 1.4; }
  .direct-card p { margin: 0; color: var(--geem-muted); font-size: .93rem; line-height: 1.75; }
  .whatsapp-card { background: #e6f5ef; border-color: #c7e6dc; }
  .whatsapp-icon { background: #fff; border: 1px solid #c7e6dc; }
  .whatsapp-card p { color: #3d6259; }
  .phone-card { background: #fff; }
  .phone-icon { color: var(--geem-navy-800); background: #edf3f6; }
  .direct-action, .phone-number { display: flex; align-items: center; flex-wrap: wrap; gap: .8rem; margin-block-start: 1.3rem; font-size: .95rem; font-weight: 600; }
  .phone-number bdi { font-size: clamp(1.13rem, 1.8vw, 1.4rem); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .direct-card:hover { border-color: var(--geem-blue); box-shadow: 0 5px 18px #0e2f440a; }
  .direct-card:hover .direct-action { text-decoration: underline; text-underline-offset: .2em; }
  .contact-secondary { display: grid; grid-template-columns: 1.1fr .9fr 1fr; gap: 2rem; margin-block-start: 2.25rem; padding-block-start: 2rem; border-block-start: 1px solid var(--geem-border); }
  .contact-secondary > section { min-width: 0; }
  .contact-secondary > section + section { border-inline-start: 1px solid var(--geem-border); padding-inline-start: 2rem; }
  .contact-secondary h2 { margin: 0 0 .5rem; font-size: 1.05rem; font-weight: 600; line-height: 1.5; }
  .contact-secondary p:not(.contact-eyebrow) { margin: 0; font-size: .88rem; line-height: 1.8; color: var(--geem-muted); }
  .customer-contact .contact-eyebrow { min-height: 1.5rem; margin: 0 0 .7rem; font-size: .74rem; }
  .secondary-icon { display: flex; align-items: center; height: 1.5rem; margin-block-end: .7rem; color: var(--geem-blue); }
  .secondary-icon svg { width: 1.3rem; height: 1.3rem; }
  .workspace-link { display: inline-flex; align-items: center; gap: .6rem; min-height: 2.8rem; margin-block-start: 1rem; padding: .55rem .8rem; border: 1px solid #b4c6d0; border-radius: .45rem; color: var(--geem-navy-900); background: #fff; text-decoration: none; font-size: .8rem; font-weight: 600; }
  .workspace-link svg { width: 1rem; height: 1rem; flex: 0 0 auto; }
  .workspace-link:hover { border-color: var(--geem-navy-800); background: #edf3f6; }
  .general-email { display: inline-flex; align-items: center; gap: .55rem; min-height: 2.75rem; margin-block-start: .6rem; color: var(--geem-navy-900); font-size: .93rem; font-weight: 600; text-decoration-thickness: 1px; text-underline-offset: .25em; }
  .general-email bdi { overflow-wrap: anywhere; }
  address { margin-block-start: .7rem; color: var(--geem-navy-800); font-style: normal; font-size: .83rem; line-height: 1.8; }
  a:focus-visible { outline: 3px solid var(--geem-blue); outline-offset: 4px; }
  .contact-sales a:focus-visible { outline-color: #fff; }
  :global(html[dir='rtl']) .direction-arrow { transform: scaleX(-1); }
  :global(html[lang='ar']) .contact-page h1 { max-width: 20ch; line-height: 1.4; font-size: clamp(2rem, 3.25vw, 2.7rem); }
  :global(html[lang='ar']) .contact-introduction { font-size: 1.07rem; }
  @media (max-width: 950px) {
    .contact-intro { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2rem; }
    .contact-primary { grid-template-columns: 1fr 1fr; }
    .contact-sales { padding: 1.5rem; }
    .direct-card { flex-direction: column; gap: 1rem; padding: 1.5rem; }
    .contact-icon { width: 2.75rem; height: 2.75rem; }
    .contact-secondary { grid-template-columns: 1.1fr .9fr; gap: 1.5rem; }
    .contact-secondary > section + section { padding-inline-start: 1.5rem; }
    .contact-secondary .company-contact { grid-column: 1 / -1; padding: 1.25rem 0 0; border-inline-start: 0; border-block-start: 1px solid var(--geem-border); }
  }
  @media (max-width: 640px) {
    .contact-page { padding-block: 2rem 3rem; }
    .contact-intro { grid-template-columns: 1fr; gap: 1rem; margin-block-end: 1.5rem; }
    .contact-introduction { max-width: 44ch; font-size: .96rem; }
    h1 { font-size: 2.05rem; max-width: 20ch; }
    :global(html[lang='ar']) .contact-page h1 { font-size: 2rem; max-width: 22ch; }
    .contact-primary { grid-template-columns: 1fr; gap: 1rem; }
    .contact-direct { gap: 1rem; }
    .contact-sales { padding: 1.5rem; }
    .direct-card { flex-direction: row; padding: 1.4rem; gap: 1rem; }
    .direct-card h2 { font-size: 1.18rem; }
    .direct-action, .phone-number { margin-block-start: 1rem; }
    .contact-secondary { grid-template-columns: 1fr; margin-block-start: 1.75rem; padding-block-start: 1.75rem; gap: 1.5rem; }
    .contact-secondary > section + section { padding: 1.5rem 0 0; border-inline-start: 0; border-block-start: 1px solid var(--geem-border); }
    .contact-secondary .company-contact { grid-column: auto; padding-block-start: 1.5rem; }
  }
  @media (max-width: 360px) {
    .contact-sales, .direct-card { padding: 1.2rem; }
    .direct-card { gap: .75rem; }
    .direct-card .contact-icon { width: 2.3rem; height: 2.3rem; }
    .phone-number { gap: .4rem; }
    .phone-number bdi { font-size: 1.06rem; }
  }
</style>
