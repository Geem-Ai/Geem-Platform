---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getSiteCopy } from '../../content/site';
import { isLocale, localeStaticPaths } from '../../lib/i18n';
import Hero from '../../components/sections/Hero.astro';
import ValueStrip from '../../components/sections/ValueStrip.astro';
import PlatformFoundation from '../../components/sections/PlatformFoundation.astro';
import Deployment from '../../components/sections/Deployment.astro';
import Experts from '../../components/sections/Experts.astro';
import Integrations from '../../components/sections/Integrations.astro';
import Channels from '../../components/sections/Channels.astro';
import Solutions from '../../components/sections/Solutions.astro';
import RoboticsRoadmap from '../../components/sections/RoboticsRoadmap.astro';
import DeveloperApi from '../../components/sections/DeveloperApi.astro';
import Security from '../../components/sections/Security.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';

export function getStaticPaths() {
  return localeStaticPaths();
}

const raw = Astro.params.locale;
if (!isLocale(raw)) {
  return Astro.redirect('/ar', 302);
}
const locale = raw;
const copy = getSiteCopy(locale);
---

<MarketingLayout
  locale={locale}
  copy={copy}
  title={copy.meta.homeTitle}
  description={copy.meta.homeDescription}
>
  <Hero locale={locale} copy={copy} />
  <ValueStrip copy={copy} />
  <PlatformFoundation locale={locale} />
  <Deployment locale={locale} />
  <Experts copy={copy} />
  <Solutions locale={locale} />
  <RoboticsRoadmap locale={locale} />
  <Integrations locale={locale} copy={copy} />
  <Channels copy={copy} />
  <DeveloperApi locale={locale} copy={copy} />
  <Security locale={locale} copy={copy} />
  <FinalCTA locale={locale} copy={copy} />
</MarketingLayout>
