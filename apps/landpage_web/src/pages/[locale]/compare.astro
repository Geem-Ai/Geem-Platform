---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import ComparisonPage from '../../components/sections/ComparisonPage.astro';
import { getComparisonCopy } from '../../content/comparison';
import { getSiteCopy } from '../../content/site';
import { isLocale, localeStaticPaths } from '../../lib/i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const raw = Astro.params.locale;
if (!isLocale(raw)) return Astro.redirect('/ar/compare', 302);
const locale = raw;
const copy = getComparisonCopy(locale);
---

<MarketingLayout
  locale={locale}
  copy={getSiteCopy(locale)}
  title={copy.meta.title}
  description={copy.meta.description}
  path="compare"
>
  <ComparisonPage locale={locale} copy={copy} />
</MarketingLayout>
