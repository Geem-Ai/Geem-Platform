# Geem Platform Admin (dashboard_web) — local environment

# FastAPI base URL (browser-reachable). Do not send Workspace headers.
VITE_API_URL=http://localhost:8000

# Informational — production Host for this SPA (mtfm.geem.ai).
# UAT overlay sets VITE_ADMIN_HOST=admin-uat.geem.ai and VITE_API_URL=https://api-uat.geem.ai.
# The API enforces APP_ADMIN_HOST; this is UX/docs only.
VITE_ADMIN_HOST=admin.localhost

# local | production
VITE_APP_ENV=local

# Cookie/CORS:
# - Browser uses credentials: include for auth cookie refresh
# - Refresh cookie is HttpOnly on the API host, Path=/api/auth, SameSite=Lax
# - Open SPA as http://localhost:5175 or http://admin.localhost:5175
# - CORS_ORIGINS must include this origin (see repo .env.example)
# - dashboard_web is NOT a tenant application. Do not use X-Workspace-Slug.
